package blocks

import (
	"fmt"
	"seek/internal/features/_shared/sharedmodels"
	educatorBlocks "seek/internal/features/educators/blocks"
	educatorDTO "seek/internal/features/educators/dto"
	"seek/internal/features/periods/dto"
	scheduleDTO "seek/internal/features/schedules/dto"
	studentBlocks "seek/internal/features/students/blocks"
	studentDTO "seek/internal/features/students/dto"
	"seek/internal/ui/core/coreblocks/forms"
	"seek/pkg/templui/components/input"
	"seek/pkg/templui/components/label"

	"github.com/starfederation/datastar-go/datastar"
	"seek/pkg/utils"
)

type PeriodFormProps struct {
	FormType          sharedmodels.FormType
	Period            dto.PeriodView
	EducatorSelect    educatorDTO.SelectView
	SelectedEducators []educatorDTO.EducatorView
	StudentSelect     studentDTO.SelectView
	SelectedStudents  []studentDTO.StudentView
}

templ PeriodForm(p PeriodFormProps, schedules []scheduleDTO.PersonWithScheduleView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<form
		id={ fmt.Sprintf("period-%s-form", p.FormType.Word()) }
		class="w-full md:max-w-128 gap-8 flex flex-col mb-8"
		data-on:submit={ datastar.PostSSE("%s", url) }
		data-signals:form_type={ p.FormType.String() }
	>
		<div
			class="w-full gap-6 flex flex-wrap"
			data-signals:period={ templ.JSONString(p.Period) }
		>
			@CoreFields(p.Period)
			@EducatorFields(p)
			@forms.Fieldset("time") {
				<div class="w-full flex gap-8 items-center">
					@FormTimePickers(p.Period)
					@DurationSlider(p.Period)
				</div>
			}
			@forms.Fieldset("day(s)") {
				@forms.DayButtons(p.Period)
			}
			@StudentFields(p)
		</div>
		<footer class="flex justify-end gap-6 mb-8">
			if p.FormType == sharedmodels.FormTypeEdit {
				@forms.DeleteButton("period", p.Period.ID)
			}
			@forms.CancelButton("/periods")
			@forms.SaveButton()
		</footer>
	</form>
}

templ CoreFields(period dto.PeriodView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@forms.Fieldset("core info") {
		<input id="period-id" class="hidden" data-bind:period.id value={ period.ID }/>
		<div class="flex flex-col">
			@label.Label(label.Props{
				ID:    "period-title-label",
				For:   "period-title-input",
				Class: "mb-3 text-neutral-content/90",
			}) {
				title
			}
			@input.Input(input.Props{
				ID:   "period-title-input",
				Name: "period-title-input",
				Type: input.TypeText,
				Attributes: templ.Attributes{
					"data-bind":                     "period.title",
					"data-on:input__debounce.250ms": utils.QueryValidate(url),
				},
			})
		</div>
		@forms.SelectServiceType("period", period.ServiceType)
	}
}

templ EducatorFields(p PeriodFormProps) {
	@forms.Fieldset("educator(s)") {
		<input id="educator-ids" class="hidden" data-bind:period.educator_ids/>
		@educatorBlocks.SelectMulti("period", p.EducatorSelect)
		@educatorBlocks.SelectListCards(p.SelectedEducators)
	}
}

templ StudentFields(p PeriodFormProps) {
	@forms.Fieldset("student(s)") {
		<input id="student-ids" class="hidden" data-bind:period.student_ids/>
		@studentBlocks.SelectMulti("period", p.StudentSelect)
		@studentBlocks.SelectListCards(p.SelectedStudents)
	}
}
