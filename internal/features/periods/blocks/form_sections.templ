package blocks

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/periods/dto"
	scheduledto "seek/internal/features/schedules/dto"
	sblocks "seek/internal/features/students/blocks"
	"seek/internal/ui/core/coreblocks/forms"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/checkbox"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/input"
	"seek/pkg/templui/components/label"
	"seek/pkg/templui/components/selectbox"
)

templ FormSections(view dto.PeriodFormView, schedules []scheduledto.PersonWithScheduleView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@selectbox.Script()
	@forms.Fieldset("core info") {
		<input id="period-id" class="hidden" data-bind:period.id value={ view.ID }/>
		<div>
			@label.Label(label.Props{
				ID:    "period-educator-select-box-label",
				For:   "period-educator-select-box",
				Class: "mb-3 text-neutral-content/80",
			}) {
				educator(s)
			}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					ID:        "period-educator-select-box",
					ShowPills: true,
					DataBind:  "period.educator_ids",
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "select at least one educator",
					})
				}
				@selectbox.Content() {
					for i := range view.EducatorOptions {
						@selectbox.Item(selectbox.ItemProps{
							Value:    view.EducatorOptions[i].Educator.ID,
							Selected: view.EducatorOptions[i].IsSelected,
						}) {
							{ view.EducatorOptions[i].Educator.NameInitial() }
						}
					}
				}
			}
		</div>
		<div class="flex flex-col">
			@label.Label(label.Props{
				ID:    "period-title-label",
				For:   "period-title-input",
				Class: "mb-3 text-neutral-content/90",
			}) {
				title
			}
			@input.Input(input.Props{
				ID:    "period-title-input",
				Value: view.Title,
				Attributes: templ.Attributes{
					"data-bind":     "period.title",
					"data-on:input": fmt.Sprintf("@post('%s/validate')", url),
				},
			})
		</div>
		@forms.SelectboxServiceType(url, "period", view.ServiceType)
	}
	@forms.Fieldset("time") {
		<div class="w-full flex gap-8 items-center">
			@FormTimePickers(view)
			@DurationSlider(view)
		</div>
	}
	@forms.Fieldset("days") {
		@forms.DayButtons(view)
	}
	@forms.Fieldset("student(s)") {
		@sblocks.StudentMultiselectNew("period", view.StudentOptions, view.StudentIDs)
		if len(schedules) > 1 {
			@SelectedScheduleList(url, schedules)
		}
	}
}

// only renders when the passed value includes more than just the base schedule
templ SelectedScheduleList(url string, students []scheduledto.PersonWithScheduleView) {
	<ul>
		for _, student := range students {
			@SelectedScheduleItem(url, student)
		}
	</ul>
}

templ SelectedScheduleItem(url string, student scheduledto.PersonWithScheduleView) {
	<li
		class="flex items-center rounded-md py-[0.3rem] px-3 hover:bg-primary/20 group"
		data-color={ student.Color }
	>
		@checkbox.Checkbox(checkbox.Props{
			Checked: student.IsVisible,
			Name:    "schedules",
			Attributes: templ.Attributes{
				"data-bind":      fmt.Sprintf("schedules.%s", student.Person.Username),
				"data-on:change": fmt.Sprintf("@post('%s/validate')", url),
			},
		})
		<span class="ml-4">{ student.Person.FullName() }</span>
		@button.Button(button.Props{
			Class:   "ml-auto opacity-0 group-hover:opacity-100",
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
		}) {
			@icon.X()
		}
	</li>
}
