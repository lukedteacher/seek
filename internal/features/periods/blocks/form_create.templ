package blocks

import (
	"seek/internal/features/periods/dto"
	sdto "seek/internal/features/schedules/dto"
	"seek/internal/ui/core/coreblocks/forms"

	"github.com/starfederation/datastar-go/datastar"
	"seek/internal/features/_shared/sharedmodels"
)

templ FormCreate(view dto.PeriodFormView, schedules []sdto.PersonWithScheduleView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<form
		id="create-period-form"
		class="seek-form w-full md:max-w-128 h-fit"
		data-on:submit={ datastar.PostSSE(url) }
	>
		@FormSections(view, schedules)
		<footer>
			@forms.CancelButton()
			@forms.SaveButton()
		</footer>
	</form>
}
