package pages

import (
	"seek/internal/features/users/models"
	"seek/internal/views/layouts"
)

templ NotFound(user models.User) {
	@layouts.Base("SEEK: period not found", user) {
		<main id="main">
			<section>
				<h3>not found</h3>
				<p>that period doesn't seem to exist. are you sure you're in the right place?</p>
			</section>
		</main>
	}
}
