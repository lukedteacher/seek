package pages

import (
	"fmt"

	"seek/internal/features/periods/blocks"
	"seek/internal/features/periods/dto"
	"seek/internal/features/users/models"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

templ View(user models.User, view dto.PeriodView) {
	@corelayouts.LayoutBase("SEEK: period", user) {
		<main id="main" data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", view.URL)) }>
			@coreblocks.HeaderMain("view period", view.URL)
			<section>
				@blocks.Card(view)
			</section>
		</main>
	}
}
