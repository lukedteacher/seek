package pages

import (
	"fmt"

	"seek/internal/features/periods/blocks"
	"seek/internal/features/users/models"
	"seek/internal/views"
	"seek/internal/views/dto"
	"seek/internal/views/layouts"
)

templ View(user models.User, period dto.PeriodView) {
	@layouts.Base("SEEK: period", user) {
		<main id="main" data-init={ views.LongRunningGetSSE(fmt.Sprintf("/periods/%s/view/stream", period.ID)) }>
			<section>
				@blocks.Card(period)
			</section>
		</main>
	}
}
