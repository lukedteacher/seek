package pages

import (
	"fmt"
	
	"seek/internal/features/periods/blocks"
	"seek/internal/views"
	"seek/internal/views/layouts"
	"seek/internal/views/dto"
)

templ View(period dto.PeriodView) {
	@layouts.Base("SEEK: period") {
		<main id="main" data-init={ views.LongRunningGetSSE(fmt.Sprintf("/periods/%s/stream", period.ID)) }>
			<section>
				@blocks.Card(period)
			</section>
		</main>
	}
}