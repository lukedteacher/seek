package pages

import (
	"seek/internal/features/profiles/blocks"
	"seek/internal/features/users/models"
	sse "seek/internal/views"
	"seek/internal/views/layouts"
)

templ EditProfile(user models.User, view any) {
	@layouts.Base("SEEK: edit your profile", user) {
		<main data-init={ sse.LongRunningGetSSE("/profile/edit/stream") }>
			<section style="width: 100%; max-width: 52rem;">
				@blocks.EditProfileForm(user)
			</section>
		</main>
	}
}
