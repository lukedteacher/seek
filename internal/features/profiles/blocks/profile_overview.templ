package blocks

import (
	"seek/internal/features/users/models"
	"seek/pkg/templui/components/avatar"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/card"
	"seek/pkg/templui/components/icon"
)

templ ProfileOverview(user models.User) {
	<div class="mx-auto px-4 py-8 max-w-[52rem]">
		<div class="max-w-6xl mx-auto">
			@Header(user)
			@Overview(user)
			@Stats()
			@RecentActivity()
		</div>
	</div>
}

templ Header(user models.User) {
	<div class="flex items-start justify-between gap-4 mb-[2rem]">
		<div class="flex items-center gap-4">
			@avatar.Avatar(avatar.Props{Class: "h-16 w-16"}) {
				if user.Avatar != "" {
					@avatar.Image(avatar.ImageProps{
						Src: user.Avatar,
					})
				}
				@avatar.Fallback() {
					TODO
				}
			}
			<div>
				<h3>
					{ "@" + user.Username }
				</h3>
				<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						teacher
					}
				</div>
			</div>
		</div>
		<div style="display: flex; flex-direction: column; gap: 0.75rem; width: auto;">
			@button.Button(button.Props{
				Href: "/profile/edit",
			}) {
				@icon.Settings(icon.Props{Size: "16px"})
				<span style="margin-left: 0.5rem;">edit profile</span>
			}
		</div>
	</div>
}

templ Overview(user models.User) {
	<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
		@InfoCard("personal", icon.User(icon.Props{Size: "20px"})) {
			@InfoItem("email", user.Email)
			@InfoItem("bio", user.Bio)
		}
		@InfoCard("professional", icon.School(icon.Props{Size: "20px"})) {
			@InfoItem("role", "resource room teacher")
			@InfoItem("department", "SPED")
			@InfoItem("teaching since", "2016")
		}
	</div>
}

templ InfoCard(title string, iconComponent templ.Component) {
	@card.Card(card.Props{
		Class: "border-muted bg-linear-3-4",
	}) {
		@card.Header() {
			@card.Title() {
				<div style="display: flex; align-items: center; gap: 0.5rem;">
					@iconComponent
					<h3>{ title }</h3>
				</div>
			}
		}
		@card.Content() {
			<div style="display: flex; flex-direction: column; gap: 0.75rem;" class="space-y-3">
				{ children... }
			</div>
		}
	}
}

templ InfoItem(label, value string) {
	<div style="display: flex; gap: 0.25rem; font-size: var(--font-size--1); justify-content: space-between;">
		<span style="color: color-mix(in oklch, var(--neutral-4-on) 70%, transparent);">{ label }</span>
		<span style="font-weight: var(--font-weight-medium);">{ value }</span>
	</div>
}

templ Stats() {
	<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem;">
		@StatCard("upcoming IEP meetings", "2", "+2 next month", icon.CalendarDays(icon.Props{Size: "24px"}))
		@StatCard("progress monitoring", "8 times", "2 unfinished", icon.ChartColumn(icon.Props{Size: "24px"}))
		@StatCard("pizza eaten", "1,000+ slices", "this year", icon.Pizza(icon.Props{Size: "24px"}))
	</div>
}

templ StatCard(title, value, subtitle string, iconComponent templ.Component) {
	@card.Card(card.Props{
		Class: "border-muted bg-linear-3-4",
	}) {
		@card.Content() {
			<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
				<span style="font-size: var(--font-size--1); color: color-mix(in oklch, var(--neutral-4-on) 70%, transparent);">{ title }</span>
				<div style="color: color-mix(in oklch, var(--neutral-4-on) 70%, transparent);">
					@iconComponent
				</div>
			</div>
			<div style="font-size: var(--font-size-2); font-weight: var(--font-weight-bold);">{ value }</div>
			<p style="font-size: var(--font-size--1); color: color-mix(in oklch, var(--neutral-4-on) 70%, transparent); margin-top: 0.25rem;">{ subtitle }</p>
		}
	}
}

templ RecentActivity() {
	@card.Card(card.Props{
		Class: "border-muted bg-linear-3-4",
	}) {
		@card.Header() {
			@card.Title() {
				recent activity
			}
			@card.Description() {
				your latest actions and updates
			}
		}
		@card.Content() {
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				@ActivityItem(
					icon.FileText(icon.Props{Class: "size-4"}),
					"updated profile information",
					"2 hours ago",
				)
				@ActivityItem(
					icon.UserPlus(icon.Props{Class: "size-4"}),
					"invited team member sarah@example.com",
					"5 hours ago",
				)
				@ActivityItem(
					icon.Key(icon.Props{Class: "size-4"}),
					"generated new API key",
					"1 day ago",
				)
				@ActivityItem(
					icon.Shield(icon.Props{Class: "size-4"}),
					"enabled two-factor authentication",
					"3 days ago",
				)
				@ActivityItem(
					icon.CreditCard(icon.Props{Class: "size-4"}),
					"updated billing information",
					"1 week ago",
				)
			</div>
		}
		@card.Footer() {
			@button.Button(button.Props{
				Class: "w-full",
			}) {
				view all activity
			}
		}
	}
}

templ ActivityItem(iconComponent templ.Component, title, time string) {
	<div style="display: flex; align-items: center; gap: 0.75rem;">
		@iconComponent
		<div style="flex-basis: 1; font-size: var(--font-size--1)">
			<p style="font-weight: var(--font-weight-medium);">{ title }</p>
			<p style="color: color-mix(in oklch, var(--neutral-4-on) 70%, transparent); font-size: var(--font-size--2);">{ time }</p>
		</div>
	</div>
}
