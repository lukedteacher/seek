package pages

import (
	"seek/internal/domain/models"
	"seek/internal/features/schedules/blocks"
	"seek/internal/views/layouts"
)

templ List(user models.User, schedules []models.Schedule) {
	@layouts.Base("SEEK: schedules", user) {
		<main>
			<section>
				<h2>SCHEDULE</h2>
				<p>review and enter schedule data here</p>
				<p>many features to come</p>
				@blocks.List(schedules)
			</section>
		</main>
	}
}