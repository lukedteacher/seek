package pages

import (
	"fmt"
	
	pblocks "seek/internal/features/periods/blocks"
	"seek/internal/features/schedules/blocks"
	"seek/internal/views"
	"seek/internal/views/dto"
	"seek/internal/views/layouts"
)

templ View(s dto.ScheduleView) {
	@layouts.Base("SEEK: schedule") {
		<main data-init={ views.LongRunningGetSSE("/schedules/stream") }>
			<hgroup style="display: flex; gap: var(--size-1); justify-content: center; align-items: center;">
				<h3>
					{ s.Title }
				</h3>
				<p>{ s.Teacher.FirstName }</p>
				<a href={ fmt.Sprintf("/schedules/%s/edit", s.ID) }>
					<button>edit</button>
				</a>
			</hgroup>
			@blocks.ScheduleComponent(s)
		</main>
	}
}

templ ViewWithPeriod(s dto.ScheduleView, p dto.PeriodView) {
	@layouts.Base("SEEK: schedule") {
		<main data-init={ views.LongRunningGetSSE("/schedules/stream") }>
			@pblocks.Card(p)
			@blocks.ScheduleComponent(s)
		</main>
	}
}