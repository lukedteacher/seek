package blocks

import (
	"fmt"

	"seek/internal/features/periods/dto"
	"seek/pkg/templui/components/icon"
)

templ PeriodCard(view dto.PeriodScheduleView) {
	<div
		class="w-full h-full p-[2px] text-xs"
		style={ fmt.Sprintf("grid-column: %d; grid-row: %d / span %d;", view.Column, view.Row, view.Duration) }
	>
		<button
			id={ fmt.Sprintf("period-schedule-%s-card", view.ID) }
			class="period-card w-full h-full flex flex-col items-center justify-center rounded-md border-solid border-transparent bg-neutral"
		>
			<p class="flex items-center gap-1">
				@icon.Icon(view.ServiceType.IconName())(icon.Props{
					Size: "12",
				})
				<span>{ view.ServiceType.ShortString() }</span>
			</p>
		</button>
	</div>
	@PeriodCardStyles()
}

templ PeriodCardStyles() {
	<style>
		.period-card {
			background-color: var(--gruvbox-orange-neutral-0);
			border-style: solid;
			border-color: transparent;
			border-radius: var(--bd-rd0);
			font-size: var(--font-size--2);
		}
	</style>
}
