package blocks

import (
	"fmt"

	"seek/internal/features/periods/dto"
	"seek/pkg/templui/components/icon"
)

templ PeriodCard(view dto.PeriodScheduleView, color string) {
	<div
		class="w-full h-full p-[1px] text-xs"
		style={ fmt.Sprintf("grid-column: %d; grid-row: %d / span %d;", view.Column, view.Row, view.Duration) }
	>
		<button
			id={ fmt.Sprintf("period-schedule-%s-card", view.ID) }
			data-color={ color }
			data-service={ view.ServiceType.ShortString() }
			class="@container period-card w-full h-full flex flex-row gap-2 items-center justify-center rounded-md border border-solid border-muted"
		>
			@icon.Icon(view.ServiceType.IconName())(icon.Props{
				Size: "14",
			})
			<span class="hidden @5xs:flex">{ view.ServiceType.ShortString() }</span>
		</button>
	</div>
}
