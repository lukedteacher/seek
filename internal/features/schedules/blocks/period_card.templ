package blocks

import (
	"fmt"

	"seek/internal/features/periods/dto"
	"seek/pkg/templui/components/icon"
)

templ PeriodCard(view dto.PeriodScheduleView, color string) {
	<svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
		<defs>
			<pattern id="checker" width="20" height="20" patternUnits="userSpaceOnUse">
				<rect width="10" height="10" fill="var(--pattern-color)"></rect>
				<rect x="10" y="10" width="10" height="10" fill="var(--pattern-color)"></rect>
			</pattern>
		</defs>
	</svg>
	<div
		class="w-full h-full p-[1px] text-xs"
		style={ fmt.Sprintf("grid-column: %d; grid-row: %d / span %d;", view.Column, view.Row, view.Duration) }
	>
		<button
			id={ fmt.Sprintf("period-schedule-%s-card", view.ID) }
			data-color={ color }
			data-service={ view.ServiceType.ShortString() }
			class="@container period-card w-full h-full flex flex-row gap-2 items-center justify-center rounded-md border border-solid border-muted relative"
			style={ fmt.Sprintf("background-color: var(--gruvbox-%s-faded-0); --base-color: var(--gruvbox-%s-bright-0);", color, color) }
		>
			<svg
				class="absolute inset-0 pointer-events-none"
				style="z-index:1; opacity:0.4; left:4px; width:calc(100% - 4px); height:100%; --pattern-color: var(--base-color);"
				viewBox="0 0 100 100"
				preserveAspectRatio="xMidYMid slice"
			>
				<rect width="100" height="100" fill="url(#checker)"></rect>
			</svg>
			@icon.Icon(view.ServiceType.IconName())(icon.Props{
				Class: "z-10 relative",
				Size:  "14",
			})
			<span class="hidden @5xs:flex relative z-10 text-white [text-shadow:_0_1px_4px_rgba(0,0,0,0.7)]">{ view.ServiceType.ShortString() }</span>
		</button>
	</div>
}
