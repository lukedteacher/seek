package pages

import (
	"seek/internal/features/students/blocks"
	"seek/internal/views"
	"seek/internal/views/layouts"
	"seek/internal/views/dto"
)

templ Create(v dto.StudentFormView) {
	@layouts.Base("SEEK: create student") {
		<main data-init={ views.LongRunningGetSSE("/students/create/stream") }>
			<section>
				@blocks.CreateForm(v)
			</section>
		</main>
	}
}