package pages

import (
	"seek/internal/features/students/blocks"
	"seek/internal/features/students/dto"
	"seek/internal/features/users/models"
	"seek/internal/ui/core/corelayouts"
	sse "seek/pkg/sse"
)

templ Create(user models.User, view dto.StudentFormView) {
	@corelayouts.LayoutBase("SEEK: create student", user) {
		<main data-init={ sse.LongRunningGetSSE("/students/create/stream") }>
			<section>
				@blocks.StudentCreateForm(view)
			</section>
		</main>
	}
}
