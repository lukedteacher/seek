package pages

import (
	"seek/internal/features/students/blocks"
	"seek/internal/features/users/models"
	"seek/internal/views"
	"seek/internal/views/dto"
	"seek/internal/views/layouts"
)

templ Create(user models.User, v dto.StudentFormView) {
	@layouts.Base("SEEK: create student", user) {
		<main data-init={ views.LongRunningGetSSE("/students/create/stream") }>
			<section>
				@blocks.StudentCreateForm(v)
			</section>
		</main>
	}
}
