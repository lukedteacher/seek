package pages

import (
	"fmt"

	"seek/internal/features/_shared/shareddto"
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/students/blocks"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/tables"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

templ List(view shareddto.TableView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBase("SEEK: students") {
		<main data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@coreblocks.HeaderMain("student list")
			@tables.DataTable(view) {
				<div class="w-full flex gap-3">
					@button.Button(button.Props{
						Href: "/students/create",
					}) {
						@icon.UserRoundPlus()
						<span>create</span>
					}
					@blocks.StudentFilters()
				</div>
			}
		</main>
	}
}
