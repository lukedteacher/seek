package pages

import (
	"fmt"
	"strings"

	"seek/internal/features/_shared/sharedmodels"
	homeroomDTO "seek/internal/features/homerooms/dto"
	scheduleBlocks "seek/internal/features/schedules/blocks"
	scheduleDTO "seek/internal/features/schedules/dto"
	serviceDTO "seek/internal/features/services/dto"
	"seek/internal/features/students/blocks"
	"seek/internal/features/students/dto"
	userModels "seek/internal/features/users/models"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/dropdown"
	"seek/pkg/templui/components/icon"
)

type StudentPageView struct {
	Active   string
	Student  dto.StudentView
	Homeroom homeroomDTO.HomeroomView
	Schedule scheduleDTO.PersonWithScheduleView
	Services []serviceDTO.ServiceView
}

templ View(view StudentPageView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBase("SEEK: student") {
		<main id="main" class="flex flex-col gap-4" data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@StudentCardMain(view.Student, view.Homeroom)
			switch view.Active {
				case "info":
					<section class="w-full max-w-[900px]">
						@blocks.Card(view.Student, view.Homeroom, len(view.Schedule.Periods))
					</section>
				case "schedule":
					<section class="w-full max-w-[900px]">
						@scheduleBlocks.ScheduleComponent([]scheduleDTO.PersonWithScheduleView{view.Schedule})
					</section>
				case "services":
					<section class="w-full max-w-[900px] flex flex-col gap-2">
						@blocks.Services(view.Services)
					</section>
			}
		</main>
	}
}

templ StudentCardMain(view dto.StudentView, homeroomView homeroomDTO.HomeroomView) {
	<div class="p-6 max-w-[900px] flex flex-col sm:flex-row justify-center gap-6 border border-muted w-full rounded-md bg-black bg-linear-3-4 relative">
		@BookmarkedButton(view)
		@StudentActionMenu(view)
		<div class="flex justify-center items-center">
			{{ imgURL := fmt.Sprintf("/static/images/people/%s_%s.webp", strings.ToLower(view.FamilyName), strings.ToLower(view.GivenName)) }}
			<img src={ imgURL } style="width:8rem; height:8rem; object-fit:cover; border-radius: 50%;" onerror="this.style.display='none'"/>
		</div>
		<div class="w-full flex flex-col gap-3 max-w-[400px]">
			<h2>{ view.FullName() }</h2>
			@badge.Badge() {
				{ view.Grade.Ordinal() }
			}
			if homeroomView.ID != "" {
				<a href={ fmt.Sprintf("/homerooms/%s", homeroomView.ID) }>
					@badge.Badge() {
						{ homeroomView.Title }
					}
				</a>
			}
		</div>
	</div>
}

templ BookmarkedButton(view dto.StudentView) {
	{{
		user := userModels.GetUserFromContext(ctx)
		variant := button.VariantGhost
		if view.Bookmarked {
			variant = button.VariantDefault
		}
	}}
	@button.Button(button.Props{
		Variant: variant,
		Class:   "absolute left-2 top-2",
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/users/%s/bookmarks/students/%s')", user.ID, view.ID),
		},
	}) {
		if view.Bookmarked {
			@icon.BookmarkCheck(icon.Props{
				Class: "fill-white stroke-primary",
			})
		} else {
			@icon.Bookmark()
		}
		<span>bookmark</span>
	}
}

templ StudentActionMenu(view dto.StudentView) {
	@dropdown.Dropdown() {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "absolute top-2 right-2",
			}) {
				@icon.EllipsisVertical()
			}
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				Href: fmt.Sprintf("/students/%s/edit", view.Username),
			}) {
				@icon.Pencil(icon.Props{
					Size: "16",
				})
				edit
			}
		}
	}
}
