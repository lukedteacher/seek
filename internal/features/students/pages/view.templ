package pages

import (
	"fmt"

	"seek/internal/features/students/blocks"
	"seek/internal/features/students/dto"
	"seek/internal/features/users/models"
	"seek/internal/views"
	"seek/internal/views/layouts"
)

templ View(user models.User, s dto.StudentView) {
	@layouts.Base("SEEK: student", user) {
		<main id="main" data-init={ views.LongRunningGetSSE(fmt.Sprintf("/students/%s/stream", s.ID)) }>
			<section style="width: 100%;">
				@blocks.Card(s)
			</section>
		</main>
	}
}
