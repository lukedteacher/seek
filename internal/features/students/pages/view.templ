package pages

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	scheduleBlocks "seek/internal/features/schedules/blocks"
	scheduleDTO "seek/internal/features/schedules/dto"
	serviceDTO "seek/internal/features/services/dto"
	"seek/internal/features/students/blocks"
	"seek/internal/features/students/dto"
	userModels "seek/internal/features/users/models"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/tabs"
)

templ View(view dto.StudentView, scheduleView scheduleDTO.PersonWithScheduleView, services []serviceDTO.ServiceView, active string) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBase("SEEK: student") {
		<main id="main" class="flex flex-col" data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@coreblocks.HeaderMain(view.FullName())
			@tabs.Tabs(tabs.Props{
				ID:    "student-tabs",
				Class: "w-full md:px-3 flex flex-col gap-3",
			}) {
				<div class="flex justify-between items-center">
					@tabs.List(tabs.ListProps{
						ID:    "student-tabs-list",
						Class: "tabs-list flex w-full max-w-128 gap-1",
					}) {
						@button.Button(button.Props{
							Class: "basis-1 flex-grow py-1 h-auto",
							Href:  fmt.Sprintf("/students/%s/info", view.Username),
							Attributes: templ.Attributes{
								"data-tab-active": active == "info",
							},
						}) {
							@icon.Info(icon.Props{
								Class: "size-4",
							})
							<span class="hidden md:flex">info</span>
						}
						@button.Button(button.Props{
							Class: "basis-1 flex-grow py-1 h-auto",
							Href:  fmt.Sprintf("/students/%s/schedule", view.Username),
							Attributes: templ.Attributes{
								"data-tab-active": active == "schedule",
							},
						}) {
							@icon.CalendarRange(icon.Props{
								Class: "size-4",
							})
							<span class="hidden md:flex">schedule</span>
						}
						if view.PlanType == 3 {
							@button.Button(button.Props{
								Class: "basis-1 flex-grow py-1 h-auto",
								Href:  fmt.Sprintf("/students/%s/services", view.Username),
								Attributes: templ.Attributes{
									"data-tab-active": active == "services",
								},
							}) {
								@icon.Blocks(icon.Props{
									Class: "size-4",
								})
								<span class="hidden md:flex">services</span>
							}
						}
					}
					{{
						user := userModels.GetUserFromContext(ctx)
						variant := button.VariantGhost
						if view.Bookmarked {
							variant = button.VariantDefault
						}
					}}
					@button.Button(button.Props{
						Variant: variant,
						Attributes: templ.Attributes{
							"data-on:click": fmt.Sprintf("@post('/users/%s/bookmarks/students/%s')", user.ID, view.ID),
						},
					}) {
						if view.Bookmarked {
							@icon.BookmarkCheck(icon.Props{
								Class: "fill-white stroke-primary",
							})
						} else {
							@icon.Bookmark()
						}
						<span>bookmark</span>
					}
				</div>
				switch active {
					case "info":
						@tabs.Content(tabs.ContentProps{Value: "info", IsActive: true}) {
							<section class="w-full">
								@blocks.Card(view)
							</section>
						}
					case "schedule":
						@tabs.Content(tabs.ContentProps{Value: "schedule", IsActive: true}) {
							<section class="w-full">
								@scheduleBlocks.ScheduleComponent([]scheduleDTO.PersonWithScheduleView{scheduleView})
							</section>
						}
					case "services":
						@tabs.Content(tabs.ContentProps{Value: "services", IsActive: true}) {
							<section class="w-full flex flex-col gap-2">
								@blocks.Services(services)
							</section>
						}
				}
			}
		</main>
	}
}
