package pages

import (
	"fmt"
	"seek/internal/features/students/blocks"
	"seek/internal/features/students/dto"
	"seek/internal/features/users/models"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

templ Edit(user models.User, s dto.StudentFormView) {
	@corelayouts.LayoutBase("SEEK: edit student", user) {
		<main data-init={ sse.LongRunningGetSSE(fmt.Sprintf("/students/%s/edit/stream", s.Student.ID)) }>
			<section>
				@blocks.StudentEditForm(s)
			</section>
		</main>
	}
}
