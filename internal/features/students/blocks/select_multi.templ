package blocks

import (
	"fmt"
	"strings"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/students/dto"
	"seek/pkg/templui/components/avatar"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/label"
	"seek/pkg/templui/components/separator"
	"seek/pkg/templui/components/tooltip"
	"seek/pkg/utils"
)

templ SelectMulti(objectType string, view dto.SelectView) {
	{{
		url := sharedmodels.GetURLFromContext(ctx)
		filterSignalName := "student_select"
	}}
	<div class="flex flex-col">
		@label.Label(label.Props{
			For:   "students-list-search",
			Class: "mb-3 text-neutral-content/90",
		}) {
			select a student
		}
		<div class="flex gap-3 items-center">
			<neo-popover class="w-full" placement="bottom" match-trigger-width="true">
				<div
					class="flex items-center gap-2 relative input"
					data-neo-popover-trigger
				>
					@icon.Search(icon.Props{
						Class: "size-4 absolute left-2 top-1/2 -translate-y-1/2 stroke-neutral-content/80",
					})
					<input
						type="search"
						id="students-list-search"
						class="pl-8"
						data-bind:student_select.filter.search
						data-on:input__debounce.250ms={ fmt.Sprintf("@query('%s/validate')", url) }
					/>
				</div>
				@SelectOptions(view.Options)
			</neo-popover>
			@SelectFilterMenu(view.Filter, filterSignalName)
		</div>
	</div>
}

templ SelectOptions(options []dto.SelectOption) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<ul
		data-neo-popover-content
		class="flex flex-col gap-1 w-full h-64"
	>
		for _, student := range options {
			<li
				data-on:click={ fmt.Sprintf("@query('%s/students/%s')", url, student.ID) }
				class={ utils.TwMerge(
							"text-sm grid grid-cols-3 items-center cursor-pointer hover:bg-primary/80 active:bg-primary/90 px-2 py-1 rounded-md",
							utils.If(student.Selected, "bg-primary"),
						) }
			>
				<div class="flex gap-2 ml-2 items-center">
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{
							Src:   fmt.Sprintf("/static/images/people/%s_%s.webp", strings.ToLower(student.FamilyName), strings.ToLower(student.GivenName)),
							Class: "object-cover",
						})
						@avatar.Fallback(avatar.FallbackProps{
							Class: "bg-secondary",
						}) {
							{ student.Initials() }
						}
					}
					<span>{ student.NameInitial() }</span>
				</div>
				@badge.Badge(badge.Props{
					Class: "bg-neutral mx-auto",
				}) {
					{ student.Grade.Ordinal() }
				}
				if student.Selected {
					@icon.Check(icon.Props{Class: "size-4 ml-auto mr-2"})
				}
			</li>
		}
	</ul>
}

templ SelectFilterMenu(filter dto.Filter, filterSignalName string) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<neo-popover>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Size: button.SizeIcon,
					Attributes: templ.Attributes{
						"data-neo-popover-trigger": "",
					},
				}) {
					@icon.ListFilter()
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				HoverDelay:    250,
				HoverOutDelay: 125,
			}) {
				filter
			}
		}
		<div
			class="p-3"
			data-neo-popover-content
		>
			@StudentGradesFilter(filterSignalName, url+"/validate", filter.Grade)
			@separator.Separator(separator.Props{
				Class: "mt-4 mb-2",
			})
			@StudentPlanTypesFilter(filterSignalName, url+"/validate", filter.PlanType)
		</div>
	</neo-popover>
}

templ SelectCards(options []dto.SelectOption) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<div class="py-3 grid grid-cols-2 md:grid-cols-3 gap-2">
		for _, student := range options {
			if student.Selected {
				<div class="group min-w-36 w-full h-18 flex gap-4 relative items-center justify-center rounded-md bg-linear-2 text-sm">
					@avatar.Avatar() {
						@avatar.Fallback() {
							{ student.Initials() }
						}
					}
					<span>{ student.NameInitial() }</span>
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Class:   "opacity-0 absolute top-1 right-1 group-hover:opacity-100 transition-all duration-150",
						Attributes: templ.Attributes{
							"data-on:click": fmt.Sprintf("@post('%s/students/%s')", url, student.ID),
						},
					}) {
						@icon.X()
					}
				</div>
			}
		}
	</div>
}
