package blocks

import (
	"fmt"

	"seek/internal/views/components"
	"seek/internal/views/dto"
)

templ StudentList(students []dto.StudentView) {
	<table>
		<thead>
			<th>link</th>
			<th>first</th>
			<th>chosen</th>
			<th>last</th>
			<th>grade</th>
			<th>homeroom</th>
			<th>case manager</th>
		</thead>
		<tbody>
			for _, student := range students {
				<tr>
					<td>
						<a href={ fmt.Sprintf("/students/%s", student.ID) }>
							@components.Icon("mdi:link")
						</a>
					</td>
					<td>{ student.FirstName }</td>
					<td>{ student.ChosenName }</td>
					<td>{ student.LastName }</td>
					<td>{ student.Grade }</td>
					<td>{ student.Homeroom }</td>
					<td>
							{ student.CaseManager }
					</td>
				</tr>
			}
		</tbody>
	</table>
}