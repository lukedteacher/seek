package blocks

import (
	"fmt"
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/label"
	"seek/pkg/templui/components/selectbox"
)

templ StudentFilters(filter map[string]bool) {
	<div class="flex flex-col gap-4" data-signals:table.filter.grade={ templ.JSONString(filter) }>
		@button.Button(button.Props{
			Attributes: templ.Attributes{
				"data-on:click": "$show_filter = !$show_filter",
			},
		}) {
			@icon.ListFilter()
			<span>filter</span>
		}
		<div
			style="display: none;"
			class="rounded-md border border-muted bg-linear-3-4 p-4 flex flex-col gap-3"
			data-signals:show_filter="false"
			data-show="$show_filter"
		>
			@StudentGradesFilter()
		</div>
	</div>
}

templ StudentGradesFilter() {
	<div class="flex flex-col gap-3">
		<h4>grades</h4>
		<div class="button-group">
			for _, grade := range sharedmodels.GradeList {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"data-class:bg-primary": fmt.Sprintf("$table.filter.grade.%d", grade),
						"data-on:click":         fmt.Sprintf("$table.filter.grade.%[1]d = !$table.filter.grade.%[1]d; @post('/students')", grade),
					},
				}) {
					{ grade.Ordinal() }
				}
			}
		</div>
	</div>
}

templ StudentHomeroomFilter() {
	<div>
		@label.Label(label.Props{
			Class: "mb-3 text-primary-content/80",
		}) {
			homeroom
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{
				Multiple: true,
			}) {
				@selectbox.Value()
			}
			@selectbox.Content(selectbox.ContentProps{
				NoSearch: true,
			}) {
				for _, grade := range sharedmodels.GradeList {
					@selectbox.Item(selectbox.ItemProps{
						Value: grade.Str(),
					}) {
						{ grade.Ordinal() }
					}
				}
			}
		}
	</div>
}
