package blocks

import (
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/dropdown"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/label"
	"seek/pkg/templui/components/selectbox"
)

templ StudentFilters() {
	@selectbox.Script()
	@dropdown.Script()
	<div class="mb-3 w-full">
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				@button.Button() {
					@icon.ListFilter(icon.Props{
						Class: "size-4",
					})
					<span>filters</span>
				}
			}
			@dropdown.Content(dropdown.ContentProps{
				Class: "w-50",
			}) {
				@dropdown.Sub() {
					@dropdown.SubTrigger(dropdown.SubTriggerProps{
						Class: "text-neutral-content/90",
					}) {
						grade
					}
					@dropdown.SubContent() {
						for _, grade := range sharedmodels.GradeList {
							@dropdown.Item() {
								{ grade.Ordinal() }
							}
						}
					}
				}
				@dropdown.Sub() {
					@dropdown.SubTrigger(dropdown.SubTriggerProps{
						Class: "text-neutral-content/90",
					}) {
						homeroom
					}
					@dropdown.SubContent() {
						for _, grade := range sharedmodels.GradeList {
							@dropdown.Item() {
								{ grade.Ordinal() }
							}
						}
					}
				}
				@dropdown.Sub() {
					@dropdown.SubTrigger(dropdown.SubTriggerProps{
						Class: "text-neutral-content/90",
					}) {
						case manager
					}
					@dropdown.SubContent() {
						for _, grade := range sharedmodels.GradeList {
							@dropdown.Item() {
								{ grade.Ordinal() }
							}
						}
					}
				}
			}
		}
	</div>
}

templ StudentGradeFilter() {
	<div>
		@label.Label(label.Props{
			Class: "mb-3 text-primary-content/80",
		}) {
			grade
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{
				Multiple: true,
			}) {
				@selectbox.Value()
			}
			@selectbox.Content(selectbox.ContentProps{
				NoSearch: true,
			}) {
				for _, grade := range sharedmodels.GradeList {
					@selectbox.Item(selectbox.ItemProps{
						Value: grade.Str(),
					}) {
						{ grade.Ordinal() }
					}
				}
			}
		}
	</div>
}

templ StudentHomeroomFilter() {
	<div>
		@label.Label(label.Props{
			Class: "mb-3 text-primary-content/80",
		}) {
			homeroom
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{
				Multiple: true,
			}) {
				@selectbox.Value()
			}
			@selectbox.Content(selectbox.ContentProps{
				NoSearch: true,
			}) {
				for _, grade := range sharedmodels.GradeList {
					@selectbox.Item(selectbox.ItemProps{
						Value: grade.Str(),
					}) {
						{ grade.Ordinal() }
					}
				}
			}
		}
	</div>
}
