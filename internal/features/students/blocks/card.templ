package blocks

import (
	"fmt"

	"seek/internal/views/components/button"
	"seek/internal/views/components/card"
	"seek/internal/views/components/icon"
	"seek/internal/views/dto"
)

templ Card(view dto.StudentView) {
	@card.Card(card.Props{
		ID:    fmt.Sprintf("student-%s-card", view.ID),
		Class: "student-card",
	}) {
		@card.Header() {
			@card.Title() {
				{ view.GivenName } { view.FamilyName }
			}
			@card.Description() {
				a student description
			}
		}
		@card.Content() {
			<p>grade: { view.Grade }</p>
			<p>homeroom: { view.Homeroom }</p>
			<p>case manager: { view.CaseManager }</p>
		}
		@card.Footer() {
			@button.Button(button.Props{
				Href: fmt.Sprintf("/students/%s/edit", view.ID),
			}) {
				@icon.Pencil(icon.Props{
					Size: "16",
				})
				<span>edit</span>
			}
			@button.Button(button.Props{
				Attributes: templ.Attributes{
					"data-on:click": fmt.Sprintf("@delete('/students/%s/delete')", view.ID),
				},
			}) {
				@icon.Trash(icon.Props{
					Size: "16",
				})
				<span>delete</span>
			}
		}
	}
	@card.CardStyles()
}
