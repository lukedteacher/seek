package blocks

import (
	"fmt"

	"seek/internal/features/services/dto"
	"seek/pkg/templui/components/card"
)

templ Card(view dto.ServiceView) {
	@card.Card(card.Props{
		ID:    fmt.Sprintf("period-%s-card", view.ID),
		Class: "iep-service-card bg-linear-1 w-128 border-muted",
		Attributes: templ.Attributes{
			"style": "background-color: var(--neutral-4);",
		},
	}) {
		@card.Content(card.ContentProps{
			Class: "flex flex-col gap-4",
		}) {
			<div>
				<p class="text-md text-neutral-content/80">
					{ view.ServiceName }
				</p>
			</div>
			<div class="flex justify-between items-center">
				<p class="text-md">
					<span>{ view.FrequencyCount }</span>
					<span class="text-sm text-neutral-content/80">x </span>
					<span>{ view.DirectMinutes }</span>
					<span>( { view.IndirectMinutes } )</span>
				</p>
				<p class="text-sm">
					if view.ProviderID == "" {
						no provider listed
					} else {
						{ view.ProviderID }
					}
				</p>
				<p class="text-sm">{ view.StartDate.String() } - { view.EndDate.String() }</p>
			</div>
		}
	}
}
