package blocks

import (
	"fmt"

	"seek/internal/features/iep_services/dto"
	"seek/internal/views/components/button"
	"seek/internal/views/components/card"
	"seek/pkg/templui/components/icon"
)

templ Card(view dto.IEPServiceView) {
	@card.Card(card.Props{
		ID:    fmt.Sprintf("period-%s-card", view.IEPServiceID),
		Class: "iep-service-card",
	}) {
		@card.Header() {
			@card.Title() {
				{ view.ServiceType }
			}
			@card.Description() {
				{ view.IndirectMinutes }
			}
		}
		@card.Content() {
			<p>content</p>
		}
		@card.Footer() {
			@button.Button(button.Props{
				Href: fmt.Sprintf("/iepservices/%s/edit", view.IEPServiceID),
			}) {
				@icon.Pencil(icon.Props{
					Size: "16",
				})
				<span>edit</span>
			}
			@button.Button(button.Props{
				Attributes: templ.Attributes{
					"data-on:click": fmt.Sprintf("@delete('/iepservices/%s/delete')", view.IEPServiceID),
				},
			}) {
				@icon.Trash(icon.Props{
					Size: "16",
				})
				<span>delete</span>
			}
		}
	}
	@card.CardStyles()
}
