package pages

import (
	"seek/internal/domain/models"
	"seek/internal/features/iep_services/blocks"
	"seek/internal/views/layouts"
)

templ CSV(user models.User, view blocks.DiffTableView) {
	@layouts.Base("SEEK: IEP services", user) {
		<main>
			<section>
				<h2>IEP services from a CSV file</h2>
				@blocks.DiffTable(view)
			</section>
		</main>
	}
}
