package pages

import (
	"seek/internal/features/iep_services/blocks"
	"seek/internal/features/iep_services/dto"
	"seek/internal/features/users/models"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

templ Create(user models.User, view dto.IEPServiceFormView) {
	@corelayouts.LayoutBase("SEEK: create service", user) {
		<main data-init={ sse.LongRunningGetSSE("/iepservices/create/stream") }>
			<section>
				@blocks.CreateServiceForm(view)
			</section>
		</main>
	}
}
