package pages

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/models"
	scheduleBlocks "seek/internal/features/schedules/blocks"
	scheduleDTO "seek/internal/features/schedules/dto"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/tabs"
)

type ScheduleProps struct {
	Toasts   []sharedmodels.Toast
	Educator models.Educator
	Periods  []scheduleDTO.SchedulePeriodView
}

templ Schedule(props ScheduleProps) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBaseWithProps(corelayouts.Props{
		Title:  "SEEK: " + props.Educator.FullName(),
		Toasts: props.Toasts,
	}) {
		<main id="main" class="flex flex-col gap-4" data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@coreblocks.HeaderMain(props.Educator.FullName())
			@tabs.Tabs(tabs.Props{
				ID:    "educator-tabs",
				Class: "w-full md:px-3 flex flex-col gap-3",
			}) {
				@tabs.List(tabs.ListProps{
					ID:    "educator-tabs-list",
					Class: "tabs-list flex w-full max-w-128 gap-1",
				}) {
					@button.Button(button.Props{
						Class:      "basis-1 flex-grow py-1 h-auto",
						Href:       fmt.Sprintf("/educators/%s/info", props.Educator.Username),
						Attributes: templ.Attributes{"data-tab-active": false},
					}) {
						@icon.Info(icon.Props{Class: "size-4"})
						<span class="hidden md:flex">info</span>
					}
					@button.Button(button.Props{
						Class:      "basis-1 flex-grow py-1 h-auto",
						Href:       fmt.Sprintf("/educators/%s/schedule", props.Educator.Username),
						Attributes: templ.Attributes{"data-tab-active": true},
					}) {
						@icon.CalendarRange(icon.Props{Class: "size-4"})
						<span class="hidden md:flex">schedule</span>
					}
					if props.Educator.IsCaseManager() {
						@button.Button(button.Props{
							Class:      "basis-1 flex-grow py-1 h-auto",
							Href:       fmt.Sprintf("/educators/%s/caseload", props.Educator.Username),
							Attributes: templ.Attributes{"data-tab-active": false},
						}) {
							@icon.FolderOpen(icon.Props{Class: "size-4"})
							<span class="hidden md:flex">caseload</span>
						}
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "schedule", IsActive: true}) {
					<section class="w-full">
						@scheduleBlocks.ScheduleComponent([]scheduleDTO.PersonWithScheduleView{}) {
							for _, period := range props.Periods {
								@scheduleBlocks.EducatorPeriodCard(scheduleBlocks.EducatorPeriodCardProps{
									View: period,
								})
							}
						}
					</section>
				}
			}
		</main>
	}
}
