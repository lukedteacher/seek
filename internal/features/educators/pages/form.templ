package pages

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/blocks"
	"seek/internal/features/educators/models"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/forms"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

type EducatorFormPageProps struct {
	FormType sharedmodels.FormType `json:"form_type"`
	Educator models.Educator       `json:"educator"`
}

templ EducatorFormPage(view EducatorFormPageProps) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBase(fmt.Sprintf("SEEK: %s educator", view.FormType.Word())) {
		<main data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@coreblocks.HeaderMain(fmt.Sprintf("%s educator", view.FormType.Word()))
			{{ signals, _ := templ.JSONString(view) }}
			<section class="w-full flex items-center justify-center" data-signals={ signals }>
				@forms.Form(forms.FormProps{
					FormType:   view.FormType,
					ObjectName: "educator",
					ID:         view.Educator.ID,
				}) {
					@blocks.HiddenInputs(view.Educator)
					@blocks.NameFields(view.Educator)
					@blocks.SchoolFields(view.Educator)
				}
			</section>
		</main>
	}
}
