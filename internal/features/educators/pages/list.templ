package pages

import (
	"fmt"

	"seek/internal/features/_shared/shareddto"
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/blocks"
	"seek/internal/features/educators/dto"
	"seek/internal/features/educators/models"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/filters"
	"seek/internal/ui/core/coreblocks/tables"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/icon"
	"seek/pkg/utils"
)

type ListPageProps struct {
	Toasts         []sharedmodels.Toast
	View           shareddto.TableView
	FilterButtons  uifilters.FilterButtonsProps
	Signals        ListPageSignals
	ScrollAction   string
	TopSpacerPx    int
	BottomSpacerPx int
}

type ListPageSignals struct {
	Filters        models.Filters       `json:"filter"`
	Table          ListPageTableSignals `json:"table"`
	ScrollTop      int                  `json:"scroll_top"`
	ViewportHeight int                  `json:"viewport_height"`
}

type ListPageTableSignals struct {
	Sort      shareddto.TableSort `json:"sort"`
	Columns   map[string]bool     `json:"columns"`
	GroupedBy string              `json:"grouped_by"`
}

func NewListPageSignals() ListPageSignals {
	columns := make(map[string]bool, len(dto.EducatorTableColumns))
	for _, column := range dto.EducatorTableColumns {
		columns[column.Signal] = column.Visible
	}
	return ListPageSignals{
		Table: ListPageTableSignals{
			Columns:   columns,
			Sort:      shareddto.TableSort{Column: "family_name", Direction: "ASC"},
			GroupedBy: "none",
		},
		Filters:        *models.NewFilters(),
		ScrollTop:      0,
		ViewportHeight: 0,
	}
}

templ List(p ListPageProps) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBaseWithProps(corelayouts.Props{
		Title:  "SEEK: educators",
		Toasts: p.Toasts,
	}) {
		<main
			id="main"
			data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }
			data-signals={ templ.JSONString(p.Signals) }
		>
			@coreblocks.HeaderMain("list of educators")
			<div class="w-full flex justify-between mb-4">
				@blocks.EducatorSearchWithFilter(p.Signals.Filters)
				<div class="flex gap-4">
					@GroupBySelect(p.Signals.Table.GroupedBy)
					@ColumnSelect(p.Signals.Table.Columns)
				</div>
			</div>
			@tables.VirtualDataTable(p.View, p.ScrollAction, p.TopSpacerPx, p.BottomSpacerPx)
		</main>
	}
}

templ GroupBySelect(groupedBy string) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<neo-popover>
		<button class="button" data-neo-popover-trigger>
			@icon.Group(icon.Props{
				Size: "16",
			})
			<span>group by</span>
		</button>
		<ul data-neo-popover-content class="text-sm flex flex-col gap-1">
			<li
				class={
					"flex justify-between items-center hover:bg-secondary rounded-md px-3 py-1 cursor-pointer",
					utils.If(groupedBy == "none", "bg-primary"),
				}
				{ utils.OnClick("$table.grouped_by='none'; $scroll_top=0", utils.Query(url)) }
			>
				<span>none</span>
				if groupedBy == "none" {
					@icon.Check(icon.Props{
						Size: "16",
					})
				}
			</li>
			for _, column := range dto.EducatorTableColumns {
				{{
					if !column.Groupable {
						continue
					}
				}}
				<li
					class={
						"flex justify-between items-center hover:bg-secondary rounded-md px-3 py-1 cursor-pointer",
						utils.If(groupedBy == column.Signal, "bg-primary"),
					}
					{ utils.OnClick(fmt.Sprintf("$table.grouped_by='%s'; $scroll_top=0", column.Signal), utils.Query(url)) }
				>
					<span>{ column.Display }</span>
					if groupedBy == column.Signal {
						@icon.Check(icon.Props{
							Size: "16",
						})
					}
				</li>
			}
		</ul>
	</neo-popover>
}

templ ColumnSelect(columnSignals map[string]bool) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<neo-popover>
		<button class="button" data-neo-popover-trigger>
			@icon.Columns3Cog(icon.Props{
				Size: "16",
			})
			<span>columns</span>
		</button>
		<ul data-neo-popover-content class="text-sm flex flex-col gap-1">
			for _, column := range dto.EducatorTableColumns {
				{{
					visible, ok := columnSignals[column.Signal]
					if !ok {
						continue
					}
					column.Visible = visible
				}}
				<li
					class={
						"flex justify-between items-center hover:bg-secondary rounded-md px-3 py-1 cursor-pointer",
						utils.If(column.Visible, "bg-primary"),
					}
					{ utils.OnClick(fmt.Sprintf("$table.columns.%[1]s=!$table.columns.%[1]s", column.Signal), utils.Query(url)) }
				>
					<span>{ column.Display }</span>
					if column.Visible {
						@icon.Check(icon.Props{
							Size: "16",
						})
					}
				</li>
			}
		</ul>
	</neo-popover>
}
