package blocks

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/dto"
	"seek/pkg/templui/components/avatar"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/label"
	"seek/pkg/utils"
)

templ SelectMulti(parent string, view dto.SelectView) {
	@avatar.Script()
	<div class="flex flex-col">
		@label.Label(label.Props{
			For:   "educators-list-search",
			Class: "mb-3 text-neutral-content/90",
		}) {
			select an educator
		}
		<div class="flex gap-3 items-center">
			<neo-popover class="w-full h-full" placement="bottom" match-trigger-width="true">
				@SelectSearchInput()
				@SelectOptions(view.Options)
			</neo-popover>
		</div>
	</div>
}

templ SelectSearchInput() {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<div
		class="flex items-center gap-2 relative input"
		data-neo-popover-trigger
	>
		@icon.Search(icon.Props{
			Class: "size-4 absolute left-3 top-1/2 -translate-y-1/2 stroke-neutral-content/80",
		})
		<input
			type="search"
			id="educators-list-search"
			class="pl-8"
			data-bind:educator_select.filter.search
			data-on:input__debounce.250ms={ utils.QueryValidate(url) }
		/>
	</div>
}

templ SelectOptions(options []dto.SelectOption) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<ul
		data-neo-popover-content
		class="flex flex-col gap-1 w-full h-64"
	>
		for _, educator := range options {
			<li
				data-on:click={ fmt.Sprintf("@query('%s/educators/%s')", url, educator.ID) }
				class={ utils.TwMerge(
							"text-sm flex items-center justify-between cursor-pointer hover:bg-primary/80 active:bg-primary/90 px-2 py-1 rounded-md",
							utils.If(educator.Selected, "bg-primary"),
				) }
			>
				<div class="flex items-center gap-2">
					@avatar.Avatar() {
						@avatar.Fallback(avatar.FallbackProps{
							Class: "bg-secondary",
						}) {
							{ educator.Initials() }
						}
					}
					<span>{ educator.NameInitial() }</span>
				</div>
				if educator.Selected {
					@icon.Check(icon.Props{Class: "size-4"})
				}
			</li>
		}
	</ul>
}
