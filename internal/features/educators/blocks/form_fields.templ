package blocks

import (
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/models"
	"seek/internal/ui/core/coreblocks/forms"
	"seek/pkg/templui/components/label"
	"seek/pkg/templui/components/selectbox"
)

templ HiddenInputs(educator models.Educator) {
	<input id="educator-id" class="hidden" data-bind:educator.id value={ educator.ID }/>
	<input id="educator-username" class="hidden" data-bind:educator.username value={ educator.Username }/>
}

templ NameFields(educator models.Educator) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@forms.Fieldset("name") {
		@forms.TextInputWithLabel(forms.TextInputWithLabelProps{
			ID:        "given-name",
			LabelText: "given name",
			Value:     educator.GivenName,
			Bind:      "educator.given_name",
			URL:       url,
		})
		@forms.TextInputWithLabel(forms.TextInputWithLabelProps{
			ID:        "chosen-name",
			LabelText: "chosen name",
			Value:     educator.ChosenName,
			Bind:      "educator.chosen_name",
			URL:       url,
		})
		@forms.TextInputWithLabel(forms.TextInputWithLabelProps{
			ID:        "family-name",
			LabelText: "family name",
			Value:     educator.FamilyName,
			Bind:      "educator.family_name",
			URL:       url,
		})
	}
}

templ SchoolFields(educator models.Educator) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@forms.Fieldset("school") {
		@forms.TextInputWithLabel(forms.TextInputWithLabelProps{
			ID:        "email",
			LabelText: "email",
			Value:     educator.Email,
			Bind:      "educator.email",
			URL:       url,
		})
		@selectbox.SelectBox() {
			@label.Label(label.Props{
				Class: "text-neutral-content/70 mb-3",
				For:   "educator-role-select",
			}) {
				role(s)
			}
			@selectbox.Trigger(selectbox.TriggerProps{
				ID:        "educator-role-select",
				ShowPills: true,
				Attributes: templ.Attributes{
					"data-bind:educator.role": "",
				},
			}) {
				@selectbox.Value(selectbox.ValueProps{
					Placeholder: "select at least one role",
				})
			}
			@selectbox.Content(selectbox.ContentProps{
				NoSearch: true,
			}) {
				for _, role := range educator.Roles {
					@selectbox.Item(selectbox.ItemProps{
						Value:    role.String(),
					}) {
						{ role.String() }
					}
				}
			}
		}
	}
}
