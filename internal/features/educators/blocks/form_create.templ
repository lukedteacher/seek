package blocks

import (
	"seek/internal/features/educators/dto"
	"seek/internal/ui/core/coreblocks/forms"

	"github.com/starfederation/datastar-go/datastar"
)

templ EducatorCreateForm(view dto.EducatorView) {
	<form
		id="educator-create-form"
		class="seek-form"
		data-on:submit={ datastar.PostSSE(view.URL) }
	>
		<hgroup>
			<h2>create educator</h2>
			<p>create a new educator.</p>
		</hgroup>
		@FormSections(view)
		<footer>
			@forms.CancelButton()
			@forms.SaveButton()
		</footer>
	</form>
}
