package blocks

import (
	"seek/internal/features/educators/dto"
	"seek/internal/views/blocks/forms"
	"seek/pkg/templui/components/selectbox"

	"github.com/starfederation/datastar-go/datastar"
)

templ EducatorCreateForm(view dto.EducatorView) {
	<form
		id="educator-create-form"
		class="seek-form"
		data-on:submit={ datastar.PostSSE("/educators/create") }
	>
		<hgroup>
			<h2>create educator</h2>
			<p>create an educator.</p>
		</hgroup>
		<section>
			@forms.TextInputWithLabel(
				"given-name-label",
				"given name",
				"/educators/create/validate",
				"educator.given_name",
				view.GivenName,
			)
			@forms.TextInputWithLabel(
				"chosen-name-label",
				"chosen name",
				"/educators/create/validate",
				"educator.chosen_name",
				view.ChosenName,
			)
			@forms.TextInputWithLabel(
				"family-name-label",
				"family name",
				"/educators/create/validate",
				"educator.family_name",
				view.FamilyName,
			)
		</section>
		<section>
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Attributes: templ.Attributes{
						"data-bind:educator.role": "",
					},
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "select a role",
					})
				}
				@selectbox.Content(selectbox.ContentProps{
					NoSearch: true,
				}) {
					@selectbox.Item(selectbox.ItemProps{
						Value:    "coteacher",
						Selected: view.Role == "coteacher",
					}) {
						co-teacher
					}
					@selectbox.Item(selectbox.ItemProps{
						Value:    "ea",
						Selected: view.Role == "ea",
					}) {
						EA
					}
					@selectbox.Item(selectbox.ItemProps{
						Value:    "teacher",
						Selected: view.Role == "teacher",
					}) {
						teacher
					}
					@selectbox.Item(selectbox.ItemProps{
						Value:    "admin",
						Selected: view.Role == "admin",
					}) {
						admin
					}
				}
			}
			@selectbox.Script()
		</section>
		<section>
			@forms.TextInputWithLabel(
				"email-label",
				"email",
				"/educators/create/validate",
				"educator.email",
				view.Email,
			)
		</section>
		<footer>
			@forms.CancelButton()
			@forms.SaveButton()
		</footer>
	</form>
}
