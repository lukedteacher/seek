package blocks

import (
	"fmt"

	"seek/internal/features/educators/models"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/card"
)

templ Card(view models.Educator) {
	@card.Card(card.Props{
		ID:    fmt.Sprintf("educator-%s-card", view.Username),
		Class: "educator-card w-128 bg-neutral border-muted",
	}) {
		@card.Header() {
			@card.Title() {
				@icon.Info()
				<span>
					info
				</span>
			}
		}
		@card.Content(card.ContentProps{
			Class: "flex flex-col gap-3",
		}) {
			<p class="flex justify-between">
				<span class="text-neutral-content/80">given</span>
				<span>{ view.GivenName }</span>
			</p>
			<p class="flex justify-between">
				<span class="text-neutral-content/80">chosen</span>
				<span>{ view.ChosenName }</span>
			</p>
			<p class="flex justify-between">
				<span class="text-neutral-content/80">family</span>
				<span>{ view.FamilyName }</span>
			</p>
			<p class="flex justify-between">
				<span class="text-neutral-content/80">email</span>
				<span>{ view.Email }</span>
			</p>
			<p class="flex justify-between">
				<span class="text-neutral-content/80">roles</span>
				<span class="inline-flex gap-2 items-center">
					for _, role := range view.Roles {
						if role.String() != "" {
							@badge.Badge() {
								{ role.String() }
							}
						}
					}
				</span>
			</p>
		}
	}
}
