package blocks

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/educators/models"
	"seek/pkg/templui/components/icon"
	"seek/pkg/utils"
)

templ EducatorSearchWithFilter(filters models.Filters) {
	<div class="join w-full max-w-lg">
		<div class="flex items-center relative w-full">
			@icon.Search(icon.Props{
				Class: "size-4 absolute left-3 top-1/2 -translate-y-1/2 stroke-neutral-content/80",
			})
			@EducatorSearchInput()
		</div>
		@FilterMenu() {
			@FilterButtons(filters)
		}
	</div>
}

templ EducatorSearchInput() {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<input
		type="search"
		id="educator-list-search"
		class="input pl-9 join-item"
		placeholder="type to filter results..."
		{ utils.DataBind("filter.search") }
		{ utils.OnInputQuery(url) }
	/>
}

templ FilterMenu() {
	<neo-popover>
		<button data-neo-popover-trigger class="join-item w-full button">
			@icon.ListFilter()
		</button>
		<div data-neo-popover-content>
			{ children... }
		</div>
	</neo-popover>
}

templ FilterButtons(filters models.Filters) {
	<details class="w-lg" open data-preserve-attr="open">
		<summary class="px-3 py-1 bg-neutral-dark">
			<span>roles</span>
		</summary>
		<div class="button-group grid" style="grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr))">
			for _, role := range sharedmodels.EducatorRoleList {
				@FilterButton(role.String(), role.String(), filters.Roles[role])
			}
		</div>
	</details>
}

templ FilterButton(label, signal string, active bool) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	{{
		classList := "button bg-neutral-bright hover:bg-primary"
		if active {
			classList = "button bg-primary hover:bg-secondary"
		}
		expr := fmt.Sprintf(
			"$filter.roles.%[1]s = !$filter.roles.%[1]s; %[2]s",
			signal, utils.Query(url),
		)
	}}
	<button class={ classList } data-variant="outline" data-on:click={ expr }>{ label }</button>
}
