package pages

import (
	"fmt"

	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/ieps/blocks"
	"seek/internal/features/ieps/dto"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

templ View(view dto.IEPView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@corelayouts.LayoutBase("SEEK: IEP") {
		<main id="main" data-init={ sse.LongRunningGetSSE(fmt.Sprintf("%s/stream", url)) }>
			@coreblocks.HeaderMain("view IEP")
			<section class="w-full grid grid-cols-1 md:grid-cols-2 gap-6 justify-center">
				@blocks.Card(view)
			</section>
		</main>
	}
}
