package blocks

import (
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/iepservices/dto"
	"seek/internal/ui/core/coreblocks/forms"

	"github.com/starfederation/datastar-go/datastar"
)

templ EditServiceForm(view dto.IEPServiceFormView) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<form
		id="edit-iep-service-form"
		class="seek-form"
		data-on:submit={ datastar.PostSSE("%s", url) }
	>
		@FormSections(view)
		<footer>
			@forms.CancelButton()
			@forms.SaveButton()
		</footer>
	</form>
}
