package pages

import (
	"seek/internal/features/iepservices/blocks"
	"seek/internal/features/iepservices/dto"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
)

templ Create(view dto.IEPServiceFormView) {
	@corelayouts.LayoutBase("SEEK: create service") {
		<main data-init={ sse.LongRunningGetSSE("/iepservices/create/stream") }>
			@coreblocks.HeaderMain("create IEP service", view.URL)
			<section>
				@blocks.CreateServiceForm(view)
			</section>
		</main>
	}
}
