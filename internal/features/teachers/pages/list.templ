package pages

import (
	"seek/internal/features/teachers/blocks"
	"seek/internal/features/teachers/models"
	um "seek/internal/features/users/models"
	"seek/internal/ui/core/corelayouts"
	sse "seek/pkg/sse"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

templ List(user um.User, view []models.Teacher) {
	@corelayouts.LayoutBase("SEEK: teachers", user) {
		<main data-init={ sse.LongRunningGetSSE("/teachers/stream") }>
			<section>
				<h2>TEACHERS</h2>
				<p>review and enter teacher data here</p>
				<p>many features to come</p>
				<div>
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"data-on:click": "$view=0; @get('/teachers')",
						},
					}) {
						@icon.Table(icon.Props{
							Size: "16",
						})
						<span>list</span>
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"data-on:click": "$view=1; @get('/teachers')",
						},
					}) {
						@icon.LayoutGrid(icon.Props{
							Size: "16",
						})
						<span>grid</span>
					}
				</div>
				@blocks.List(view)
			</section>
		</main>
	}
}
