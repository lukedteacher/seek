package pages

import (
	"seek/internal/features/teachers/blocks"
	"seek/internal/features/teachers/models"
	um "seek/internal/features/users/models"
	sse "seek/internal/views"
	"seek/internal/views/components/button"
	"seek/internal/views/layouts"
	"seek/pkg/templui/components/icon"
)

templ List(user um.User, view int64, views []models.Teacher) {
	@layouts.Base("SEEK: teachers", user) {
		<main data-signals:view={ view } data-init={ sse.LongRunningGetSSE("/teachers/stream") }>
			<section>
				<h2>TEACHERS</h2>
				<p>review and enter teacher data here</p>
				<p>many features to come</p>
				<div>
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"data-on:click": "$view=0; @get('/teachers/list')",
						},
					}) {
						@icon.Table(icon.Props{
							Size: "16",
						})
						<span>list</span>
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"data-on:click": "$view=1; @get('/teachers/list')",
						},
					}) {
						@icon.LayoutGrid(icon.Props{
							Size: "16",
						})
						<span>grid</span>
					}
				</div>
				if view == 0 {
					@blocks.List(views)
				} else {
					@blocks.Cards(views)
				}
			</section>
		</main>
	}
}
