package pages

import (
	"seek/internal/domain/models"
	"seek/internal/features/teachers/blocks"
	"seek/internal/features/teachers/events"
	"seek/internal/views"
	"seek/internal/views/layouts"
)

templ Edit(teacher models.TeacherSignals, validation map[string]events.Validation) {
	@layouts.Base("SEEK: edit student") {
		<main data-init={ views.LongRunningGetSSE("/teachers/edit/stream") }>
			<section>
				@blocks.EditForm(teacher, validation)
			</section>
		</main>
	}
}