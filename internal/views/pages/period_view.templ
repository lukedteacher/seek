package pages

import (
	"fmt"

	"seek/internal/domain/models"
	"seek/internal/views"
	"seek/internal/views/layouts"
	"seek/internal/views/components/card"
)

templ PeriodView(period models.Period) {
	@layouts.Base("SEEK: period") {
		<main data-init={ views.LongRunningGetSSE(fmt.Sprintf("/periods/%s/stream", period.Id)) }>
			<section>
				@card.Card(card.Props{
					ID: fmt.Sprintf("period-%s-card", period.Id),
				}) {
					@card.Header() {
						@card.Title() {
							{ period.Title }
						}
						@card.Description() {
							{ period.StartTime } ... { period.Days }
						}
					}
					@card.Content() {
						<p>teacher: ...</p>
						<p>location: ...</p>
						<p>students: ...</p>
					}
					@card.Footer() {
						<a href={ fmt.Sprintf("/periods/%s/edit", period.Id) }>
							<button>edit</button>
						</a>
						<button data-on:click={ fmt.Sprintf("@delete('/periods/%s')", period.Id) }>delete</button>
					}
				}
				@card.CardStyles()
			</section>
		</main>
	}
}