package pages

import (
	"seek/internal/domain/models"
	"seek/internal/views"
	"seek/internal/views/layouts"
	"seek/internal/views/blocks"
)

templ Schedule(schedule models.ScheduleSignals) {
	@layouts.Base("SEEK: schedule") {
		<main data-init={ views.LongRunningGetSSE("/schedules/stream") }>
			@blocks.ScheduleComponent(blocks.ScheduleComponentViewModel{
				Schedule: schedule,
			})
		</main>
	}
}