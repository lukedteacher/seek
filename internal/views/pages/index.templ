package pages

import (
	"seek/internal/domain/models"
	"seek/internal/views"
	"seek/internal/views/blocks/sidebar"
	"seek/internal/views/components/card"
	"seek/internal/views/components/icon"
	"seek/internal/views/layouts"
	"seek/internal/views/components/button"
)

templ Index(user models.User, view sidebar.SidebarView) {
	@layouts.Base("SEEK", user) {
		<div style="display: flex; width: 100%; overflow-y:auto;" data-init={ views.LongRunningGetSSE("/stream") }>
			if view.Open == true {
				@sidebar.SidebarDesktop()
			} else {
				@sidebar.SidebarCollapsed()
			}
			<main>
				@button.Button(button.Props{
					Size: button.SizeIcon,
					Attributes: templ.Attributes{
						"data-signals:open": view.Open,
						"data-on:click": "$open=!$open; @post('/sidebar')",
					},
				}) {
					@icon.Icon("lucide:panel-left")
				}
				<section style="margin-bottom: var(--size-2)">
					<p>welcome to SEEK (aka shared educational environment knowledge)</p>
					<p>there many features to come</p>
					<p>below are some of the current ones</p>
				</section>
				<section style="display: grid; gap: var(--size-2); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); width: 100%;">
					@card.CardStyles()
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:calendar-range")
								schedules
							}
							@card.Description() {
								view, create, and manage schedules
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>notifications on change</li>
								<li>plan for actual calendar dates</li>
								<li>printable version for student visual schedule</li>
								<li>collaborative schedule creation</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/schedules/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/schedules/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:clock")
								periods
							}
							@card.Description() {
								periods make up schedules.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>notifications on change</li>
								<li>assign students with relevant goals</li>
								<li>take attendance</li>
								<li>lesson plans</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/periods/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/periods/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:graduation-cap")
								students
							}
							@card.Description() {
								can't live with them, can't live without their funding.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>pictures?</li>
								<li>SPED data</li>
								<li>schedule view</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/students/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/students/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:book-copy")
								services
							}
							@card.Description() {
								service minutes indicated by a student's IEP.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>charts</li>
								<li>schedule integration</li>
								<li>audits</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/iepservices/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/iepservices/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:apple")
								teachers
							}
							@card.Description() {
								they do the work of learning the students.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>profiles?</li>
								<li>view their schedule</li>
								<li>caseloads</li>
								<li>idk</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/teachers/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/teachers/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:goal")
								goals
							}
							@card.Description() {
								students have goals.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>goal bank</li>
								<li>goal builder</li>
								<li>progress tracking</li>
								<li>charts?</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/goals/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/goals/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:chart-spline")
								interventions
							}
							@card.Description() {
								plan interventions, track data, and view progress.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>easy progress monitoring</li>
								<li>automatic progress report creation</li>
								<li>links to resources</li>
								<li>charts!</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/interventions/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/interventions/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:hand-heart")
								caregivers
							}
							@card.Description() {
								caregiver info up to date and easy to access.
							}
						}
						@card.Content() {
							<p>features (coming soon)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>email templates & sending?</li>
								<li>portals for their own access to data</li>
								<li>resources for learning about disabilities?</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/caregivers/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/caregivers/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
					@card.Card() {
						@card.Header() {
							@card.Title() {
								@icon.Icon("lucide:house-heart")
								homerooms
							}
							@card.Description() {
								general education teachers will also have their own access.
							}
						}
						@card.Content() {
							<p>features (coming maybe?)</p>
							<ul style="list-style-type: circle; padding-left: var(--size--1); margin-left: var(--size-0);">
								<li>gen ed student data?</li>
								<li>interventions, goals, schedules, etc.</li>
								<li>idk</li>
							</ul>
						}
						@card.Footer() {
							@button.Button(button.Props{
								Href: "/homerooms/list",
							}) {
								@icon.Icon("lucide:list")
								<span>list</span>
							}
							@button.Button(button.Props{
								Href: "/homerooms/create",
							}) {
								@icon.Icon("lucide:plus")
								<span>create</span>
							}
						}
					}
				</section>
			</main>
		</div>
	}
}