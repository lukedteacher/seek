package pages

import (
	"seek/internal/views"
	"seek/internal/views/layouts"
	"seek/internal/views/components"
	"seek/internal/views/blocks"
)

templ Index() {
	@layouts.Base("SEEK") {
		<main>
			<section>
				<h1>SEEK</h1>
				<p>aka shared educational environment knowledge</p>
				<p>many features to come</p>
			</section>
		</main>
	}
}

type StudentsSignals struct {
	StudentDataView views.DataView
}

templ Students(view int) {
	@layouts.Base("SEEK: students") {
		<main data-signals:view={view}>
			<section>
				<h1>STUDENTS</h1>
				<p>review and enter student data here</p>
				<p>many features to come</p>
				<div>
					<input type="number" data-bind:view />
					<button data-on:click="$view=0">
						@components.Icon("solar:list-bold-duotone")
						<span>list</span>
					</button>
					<button data-on:click="$view=1">
						@components.Icon("solar:widget-bold-duotone")
						<span>cards</span>
					</button>
				</div>
				@blocks.StudentList()
			</section>
		</main>
	}
}