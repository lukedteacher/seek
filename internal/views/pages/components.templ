package pages

import (
	"seek/internal/views/layouts"
	"seek/internal/views/components/badge"
)

templ Components() {
	@layouts.Base("SEEK: components") {
		<main>
			<section style="display: grid; gap: var(--size-2);">
				<h3>badges</h3>
				@badge.BadgeStyles()
				@badge.Badge() {
					default
				}
				@badge.Badge(badge.Props{
					Attributes: templ.Attributes{
						"data-theme": "secondary",
					},
				}) {
					secondary
				}
				@badge.Badge(badge.Props{
					Attributes: templ.Attributes{
						"data-theme": "destructive",
					},
				}) {
					destructive
				}
			</section>
		</main>
	}
}