package pages

import (
	"seek/internal/features/users/models"
	"seek/internal/views/layouts"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

templ Components(user models.User) {
	@layouts.Base("SEEK: components", user) {
		<main style="display: flex; flex-direction: column; gap: 1rem;">
			<section>
				<h3>buttons</h3>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(4, 1fr) / repeat(4, 1fr); gap: var(--size-0);">
					@button.Button() {
						default
					}
					@button.Button(button.Props{
						Variant: button.VariantOutline,
					}) {
						outline
					}
					@button.Button(button.Props{
						Variant: button.VariantGhost,
					}) {
						ghost
					}
					@button.Button(button.Props{
						Variant: button.VariantLink,
					}) {
						link
					}
					@button.Button(button.Props{
						Size: button.SizeIcon,
					}) {
						@icon.Bomb(icon.Props{
							Size: "16",
						})
					}
				</div>
			</section>
			<section>
				<h3>icons</h3>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(8, 1fr) / repeat(8, 1fr); gap: var(--size-0);">
					@icon.Bomb(icon.Props{
						Size: "16",
					})
					@icon.Clock()
					@icon.LogIn()
					@icon.Sailboat()
				</div>
			</section>
			<section>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(4, 1fr) / repeat(4, 1fr); gap: var(--size-0);">
					<h3>badges</h3>
					@badge.Badge() {
						default
					}
					@badge.Badge(badge.Props{
						Variant: badge.VariantSecondary,
					}) {
						secondary
					}
					@badge.Badge(badge.Props{
						Variant: badge.VariantDestructive,
					}) {
						destructive
					}
				</div>
			</section>
		</main>
	}
}
