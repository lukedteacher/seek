package pages

import (
	"seek/internal/domain/models"
	"seek/internal/views"
	"seek/internal/views/blocks"
	"seek/internal/views/components"
	"seek/internal/views/layouts"
)

type TeachersSignals struct {
	TeacherDataView views.DataView
}

templ Teachers(view int64, teachers []models.Teacher) {
	@layouts.Base("SEEK: teachers") {
		<main data-signals:view={ view } data-init={ views.LongRunningGetSSE("/teachers/stream") }>
			<section>
				<h1>TEACHERS</h1>
				<p>review and enter teacher data here</p>
				<p>many features to come</p>
				<div>
					<button data-on:click="$view=0; @get('/teachers')">
						@components.Icon("solar:list-bold-duotone")
						<span>list</span>
					</button>
					<button data-on:click="$view=1; @get('/teachers')">
						@components.Icon("solar:widget-bold-duotone")
						<span>cards</span>
					</button>
					<button data-on:click="@get('/teacher/create')">
						@components.Icon("solar:widget-bold-duotone")
						<span>create</span>
					</button>
				</div>
				if view == 0 {
					@blocks.TeacherList(teachers)
				} else {
					@blocks.TeacherCards(teachers)
				}
			</section>
		</main>
	}
}

templ CreateTeacher() {
	@layouts.Base("SEEK: create teacher") {
		<main data-init={ views.LongRunningGetSSE("/teacher/create/stream") }>
			<section>
				<h1>CREATE A TEACHER</h1>
				<p>create a new teacher</p>
				<form data-on:submit="@post('/teacher')">
					<label for="first_name">first</label>
					<input id="first_name" name="first_name" data-bind:first_name />
					<label for="chosen_name">chosen</label>
					<input id="chosen_name" name="chosen_name" data-bind:chosen_name />
					<label for="last_name">last</label>
					<input id="last_name" name="last_name" data-bind:last_name />
					<button type="submit">
						<span>submit</span>
					</button>
				</form>
			</section>
		</main>
	}
}