package pages

import (
	"seek/internal/views"
	"seek/internal/views/blocks"
	"seek/internal/views/components"
	"seek/internal/views/layouts"
)

type StudentsSignals struct {
	StudentDataView views.DataView
}

templ Students(view int64, students []views.Student) {
	@layouts.Base("SEEK: students") {
		<main data-signals:view={ view } data-init={ views.LongRunningGetSSE("/students/stream") }>
			<section>
				<h1>STUDENTS</h1>
				<p>review and enter student data here</p>
				<p>many features to come</p>
				<div>
					<button data-on:click="$view=0; @get('/students')">
						@components.Icon("solar:list-bold-duotone")
						<span>list</span>
					</button>
					<button data-on:click="$view=1; @get('/students')">
						@components.Icon("solar:widget-bold-duotone")
						<span>cards</span>
					</button>
					<button data-on:click="@get('/student/create')">
						@components.Icon("solar:widget-bold-duotone")
						<span>create</span>
					</button>
				</div>
				if view == 0 {
					@blocks.StudentList(students)
				} else {
					@blocks.StudentCards(students)
				}
			</section>
		</main>
	}
}

templ CreateStudent() {
	@layouts.Base("SEEK: create student") {
		<main data-init={ views.LongRunningGetSSE("/student/create/stream") }>
			<section>
				<h1>CREATE A STUDENT</h1>
				<p>create a new student</p>
				<form data-on:submit="@post('/student')">
					<label for="first_name">first</label>
					<input id="first_name" name="first_name" data-bind:first_name />
					<label for="chosen_name">chosen</label>
					<input id="chosen_name" name="chosen_name" data-bind:chosen_name />
					<label for="last_name">last</label>
					<input id="last_name" name="last_name" data-bind:last_name />
					<label for="grade">grade</label>
					<input id="grade" name="grade" data-bind:grade type="number" />
					<label for="homeroom">homeroom</label>
					<input id="homeroom" name="homeroom" data-bind:homeroom />
					<label for="case_manager">case manager</label>
					<input id="case_manager" name="case_manager" data-bind:case_manager />
					<button type="submit">
						<span>submit</span>
					</button>
				</form>
			</section>
		</main>
	}
}