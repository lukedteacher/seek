package blocks

import (
  "fmt"
	"seek/internal/domain/models"
	"seek/internal/views/components/period_card"
)

type ScheduleComponentViewModel struct {
	Schedule models.ScheduleSignals
	Periods  []models.PeriodSignals
}

templ ScheduleStyle() {
	<style>
		#schedule-component {
			width: 100%;
			height: 100%;
			display: grid;
			grid-template-rows: 4rem 1fr;
			grid-template-columns: 6rem repeat(5, 1fr);
			background-color: var(--primary-4);
			color: var(--primary-4-on);
			border-style: solid;
			border-color: var(--primary-6);
			border-width: var(--border-width-0);
			border-radius: var(--border-radius-2);
			padding-right: var(--size-2);
			padding-bottom: var(--size-2);

			div.day-header {
				width: 100%;
				height: 100%;
				display: flex;
				justify-content: center;
				align-items: center;
			}

			#schedule-times {
				width: 100%;
				height: 100%;
				display: flex;
				flex-direction: column;
				font-size: var(--font-size--1);

				div {
					display: flex;
					justify-content: center;
					align-items: center;
					flex-grow: 1;
				}
			}

			#schedule-grid {
				width: 100%;
				height: 100%;
				display: grid;
				grid-template-rows: repeat(480, 1fr);
				grid-template-columns: repeat(5, 1fr);
				grid-column: 2 / -1;
			}
		}
	</style>
}

templ ScheduleComponent(vm ScheduleComponentViewModel) {
	<div id="schedule-component">
		@DayHeaders()
		@TimeColumn()
		@GridContainer() {
			@TimeGrid(30, 480)
			@DayGrid()
			for i := range vm.Periods {
				@period_card.PeriodCard(period_card.PeriodCardViewModel{
					Period: vm.Periods[i],
				})
			}
		}
		@ScheduleStyle()
	</div>
}

templ DayHeaders() {
  {{days := []string{
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
  }}}
	for index, day := range days {
		<div 
			class="day-header"
			style={ fmt.Sprintf("grid-column: %d / span 1;", index+2) }
		>
			{ day }
		</div>
	}
}

templ TimeColumn() {
  {{times := []string{
    "8:00",
    "9:00",
    "10:00",
    "11:00",
    "12:00",
    "1:00",
    "2:00",
    "3:00",
  }}}
  <div id="schedule-times">
    for _, time := range times {
      <div>
        { time }
      </div>
    }
  </div>
}

templ GridContainer() {
  <div id="schedule-grid">
    { children... }
  </div>
}

templ TimeGrid(interval int, totalRows int) {
  for index := 1; index < totalRows; index++ {
    if index%interval == 1 {
      <div 
        class="time-grid"
        style={ fmt.Sprintf("grid-row: %d / span 1;", index) }
      />
    }
  }
	<div class="time-grid" style="grid-row: -1 / span 1;"></div>
	<style>
		.time-grid {
			grid-column: 1 / -1;
			background-color: var(--primary-5);
			height: 1px;
		}
	</style>
}

templ DayGrid() {
  // this is ugly TODO: fix
  <div 
    class="day-grid" 
    style="grid-column: 1 / span 1;"
  ></div>
  for index := 1; index < 6; index++ {
    <div 
      style={ fmt.Sprintf("grid-column: %d / span 1;", index) }
      class="day-grid"
    ></div>
  }
	<style>
		.day-grid {
			grid-row: 1 / -1;
			background-color: var(--primary-5);
			width: 1px;

			&~ .day-grid {
				justify-self: end;
			}
		}
	</style>
}