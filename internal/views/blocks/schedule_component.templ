package blocks

import (
  "strconv"
)

templ ScheduleStyle() {
	<style>
		#schedule-component {
			width: 100%;
			height: 100%;
			display: grid;
			grid-template-rows: auto 1fr;
			grid-template-columns: repeat(6, 1fr);
			background-color: var(--primary-3);
			color: var(--primary-3-on);
			border-radius: var(--border-radius-2);

			header {
				width: 100%;
				height: 100%;
				display: flex;
				padding: 0;
				grid-column: 2 / -1;

				div {
					width: 100%;
					height: 100%;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: var(--size-2) var(--size-3);
				}
			}

			#schedule-times {
				width: 100%;
				height: 100%;
				display: flex;
				flex-direction: column;

				div {
					display: flex;
					justify-content: center;
					align-items: center;
					flex-grow: 1;
					padding: var(--size-2) var(--size-3);
				}
			}

			#schedule-grid {
				width: 100%;
				height: 100%;
				display: grid;
				grid-template-rows: repeat(180, 1fr);
				grid-template-columns: repeat(5, 1fr);
				grid-column: 2 / -1;
				border: 1px solid blue;
			}
		}
	</style>
}

templ ScheduleComponent(minutes int) {
	<div id="schedule-component">
		@DayHeaders()
		@TimeColumn()
		@GridContainer()
		@ScheduleStyle()
	</div>
}

templ DayHeaders() {
  {{days := []string{
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
  }}}
  <header id="schedule-days">
    for _, day := range days {
      <div>
        { day }
      </div>
    }
  </header>
}

templ TimeColumn() {
  {{times := []string{
    "8:00",
    "9:00",
    "10:00",
    "11:00",
    "12:00",
    "1:00",
    "2:00",
    "3:00",
  }}}
  <div id="schedule-times">
    for _, time := range times {
      <div>
        { time }
      </div>
    }
  </div>
}

templ GridContainer() {
  <div id="schedule-grid">
    { children... }
  </div>
}

templ TimeGrid(interval int, totalRows int) {
  // using total rows + 1 so the last and final row has a grid
  for index := 1; index < totalRows + 1; index++ {
    if index%interval == 0 {
      <div 
        style={"grid-row: " + strconv.Itoa(index) + " / span 1;"}
        class={"col-start-1 -col-end-1 bg-gray-500 h-px"} 
      />
    }
  }
}

templ DayGrid() {
  // this is ugly TODO: fix
  <div 
    style={"grid-column: 1 / span 1;"}
    class={"row-start-1 -row-end-1 bg-gray-500 w-px"} 
  />
  for index := 1; index < 6; index++ {
    <div 
      style={"grid-column: " + strconv.Itoa(index) + " / span 1;"}
      class={"row-start-1 -row-end-1 bg-gray-500 w-px justify-self-end"} 
    />
  }
}