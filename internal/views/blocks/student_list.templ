package blocks

import (
	"fmt"

	"seek/internal/domain/models"
	"seek/internal/views/components"
)

templ StudentList(students []models.Student) {
	<table>
		<thead>
			<th>link</th>
			<th>first</th>
			<th>chosen</th>
			<th>last</th>
			<th>grade</th>
			<th>homeroom</th>
			<th>case manager</th>
		</thead>
		<tbody>
			for _, student := range students {
				<tr>
					<td>
						<a href={ fmt.Sprintf("/students/%s", student.Id) }>
							@components.Icon("mdi:link")
						</a>
					</td>
					<td>{ student.FirstName }</td>
					<td>
						if student.ChosenName != nil {
							{*student.ChosenName}
						}
					</td>
					<td>{student.LastName}</td>
					<td>{student.GradeOrdinal()}</td>
					<td>{student.Homeroom}</td>
					<td>
							if student.CaseManager != nil {
								{*student.CaseManager}
							}
					</td>
				</tr>
			}
		</tbody>
	</table>
}