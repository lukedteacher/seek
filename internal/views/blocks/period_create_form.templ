package blocks

import (
	"seek/internal/features/period"
	"seek/internal/views/components/day_buttons"
	"seek/internal/views/components/input"
	"seek/internal/views/components/label"

	"github.com/starfederation/datastar-go/datastar"
	"seek/internal/domain/models"
)

templ CreatePeriodForm(validation map[string]period.Validation) {
	<form id="create-period-form" data-on:submit={ datastar.PostSSE("/periods/create") }>
		<hgroup>
			<h2>CREATE A PERIOD</h2>
			<p>create a new period.</p>
		</hgroup>
		<section>
			@label.Label(label.Props{
				ID: "title-label",
				For: "title",
				Label: "title",
				ValidationState: validation["title"].State,
				ValidationMessage: validation["title"].Message,
			}) {
				@input.Input(input.Props{
					ID: "title",
					Name: "title",
					DataBind: "period.title",
					DataOn: "/periods/create/validate",
					HasError: validation["title"].State == "error",
					IsValid: validation["title"].State == "valid",
				})
			}
			<div style="display: flex; justify-content: space-between; gap: var(--size-1);">
				@label.Label(label.Props{
					ID: "start-time-label",
					For: "start-time",
					Label: "start time",
					ValidationState: validation["start_time"].State,
					ValidationMessage: validation["start_time"].Message,
				}) {
					@input.Input(input.Props{
						ID: "start-time",
						Name: "start-time",
						DataBind: "period.start_time",
						DataOn: "/periods/create/validate",
						HasError: validation["start_time"].State == "error",
						IsValid: validation["start_time"].State == "valid",
						Value: "9:00",
					})
				}
				@label.Label(label.Props{
					ID: "end-time-label",
					For: "end-time",
					Label: "end time",
					ValidationState: validation["end_time"].State,
					ValidationMessage: validation["end_time"].Message,
				}) {
					@input.Input(input.Props{
						ID: "end-time",
						Name: "end-time",
						DataBind: "period.end_time",
						DataOn: "/periods/create/validate",
						HasError: validation["end_time"].State == "error",
						IsValid: validation["end_time"].State == "valid",
						Value: "9:30",
					})
				}
			</div>
			<label for="duration">duration</label>
			<input id="duration" name="duration" data-bind:period.duration type="number" />
			@day_buttons.DayButtons(models.DaysSignals{})
		</section>
		<footer>
			<button 
				type="button"
			>
				<span>cancel</span>
			</button>
			<button 
				type="submit"
			>
				<span>submit</span>
			</button>
		</footer>
	</form>
}
				