package forms

import (
	"fmt"
	"seek/internal/views/components/button"
	"seek/pkg/templui/components/icon"
)

templ CancelButton() {
	@button.Button(button.Props{
		Type:  "button",
		Color: button.ColorWarning,
		Attributes: templ.Attributes{
			"style": "flex: 1;",
		},
	}) {
		@icon.X(icon.Props{
			Size: "16",
		})
		<span>cancel</span>
	}
}

templ SaveButton() {
	@button.Button(button.Props{
		Type:  "submit",
		Color: button.ColorSuccess,
		Attributes: templ.Attributes{
			"style": "flex: 1;",
		},
	}) {
		@icon.Save(icon.Props{
			Size: "16",
		})
		<span>save</span>
	}
}

templ ArchiveButton(object, id string) {
	@button.Button(button.Props{
		Type:  "button",
		Color: button.ColorInfo,
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/%s/%s/archive'", object, id),
			"style":         "flex: 1;",
		},
	}) {
		@icon.Archive(icon.Props{
			Size: "16",
		})
		<span>archive</span>
	}
}

templ DeleteButton(object, id string) {
	@button.Button(button.Props{
		Type:  "button",
		Color: button.ColorError,
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/%s/%s/delete'", object, id),
			"style":         "flex: 1;",
		},
	}) {
		@icon.Trash(icon.Props{
			Size: "16",
		})
		<span>delete</span>
	}
}
