package blocks

import (
	"fmt"

	"seek/internal/domain/models"
)

templ StudentList(students []models.Student) {
	<table>
		<thead>
			<th>first</th>
			<th>chosen</th>
			<th>last</th>
			<th>grade</th>
			<th>homeroom</th>
			<th>case manager</th>
		</thead>
		<tbody>
			for _, student := range students {
				<tr>
					<td>
						<a href={ fmt.Sprintf("/student/%s", student.Id) }>{ student.FirstName }</a>
					</td>
					<td>
						if student.ChosenName != nil {
							{*student.ChosenName}
						}
					</td>
					<td>{student.LastName}</td>
					<td>{student.GradeOrdinal()}</td>
					<td>{student.Homeroom}</td>
					<td>
							if student.CaseManager != nil {
								{*student.CaseManager}
							}
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ StudentCards(students []models.Student) {
	<div class="card-grid">
		for _, student := range students {
			<div class="card">
				<p>
					if student.ChosenName != nil {
						{ *student.ChosenName }
					}
					else {
						{ student.FirstName }
					} { student.LastName }
				</p>
				<p>{ student.Grade }</p>
				<p>{ student.Homeroom }</p>
				if student.CaseManager != nil {
					<p>{ *student.CaseManager }</p>
				}
				else {
					""
				}
			</div>
		}
	</div>
}