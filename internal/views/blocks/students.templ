package blocks

import (
	"seek/internal/views"
)

templ StudentList(students []views.Student) {
	<table>
		<thead>
			<th>first</th>
			<th>chosen</th>
			<th>last</th>
			<th>grade</th>
			<th>homeroom</th>
			<th>case manager</th>
		</thead>
		<tbody>
			for _, student := range students {
				<tr>
					<td>{student.FirstName}</td>
					<td>
						if student.ChosenName != nil {
							{*student.ChosenName}
						}
						else {
							""
						}
					</td>
					<td>{student.LastName}</td>
					<td>{student.Grade}</td>
					<td>{student.Homeroom}</td>
					<td>
							if student.CaseManager != nil {
								{*student.CaseManager}
							}
							else {
								""
							}
					</td>
				</tr>
			}
		</tbody>
	</table>
}