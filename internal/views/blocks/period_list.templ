package blocks

import (
	"fmt"

	"seek/internal/domain/models"
)

templ PeriodList(periods []models.Period) {
	<table>
		<thead>
			<th>title</th>
			<th>start time</th>
			<th>duration</th>
			<th>days</th>
		</thead>
		<tbody>
			for _, period := range periods {
				<tr>
					<td>
						<a href={ fmt.Sprintf("/periods/%s", period.Id) }>{ period.Title }</a>
					</td>
					<td>{ period.StartTime }</td>
					<td>{ period.Duration }</td>
					<td>{ period.Days }</td>
				</tr>
			}
		</tbody>
	</table>
}