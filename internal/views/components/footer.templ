package components

templ Footer() {
	<footer>
		<p>probably there should be stuff here.</p>
	</footer>
	@FooterStyle()
}

templ FooterStyle() {
	<style>
		body > footer {
			display: flex;
			justify-content: start;
			align-items: center;
			height: 4rem;
			width: 100%;
			margin-top: var(--size-3);
			padding-left: var(--size-4);
			color: var(--secondary-2-on);
			background-color: var(--secondary-2);
		}
	</style>
}