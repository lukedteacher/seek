package period_card

import (
	"fmt"
	"seek/internal/domain/models"
)

type PeriodCardViewModel struct {
	Period models.PeriodSignals
	Columns []int
}

templ PeriodCards(vm PeriodCardViewModel) {
	for i := range vm.Columns {
		@PeriodCard(vm, vm.Columns[i])
	}
}

templ PeriodCard(vm PeriodCardViewModel, column int) {
	<div 
		class="period-card"
		style={fmt.Sprintf("grid-column: %d; grid-row: %s / span %d;", column, "1", vm.Period.Duration)}
	>
		<h3>{ vm.Period.Title }</h3>
	</div>
	@PeriodCardStyles()
}

templ PeriodCardStyles() {
	<style>
		.period-card {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			background-color: var(--gruvbox-orange-neutral-0);
			border-style: solid;
			border-color: var(--gruvbox-orange-neutral--1);
			border-radius: var(--border-radius-0);
			font-size: var(--font-size--2);
		}
	</style>
}