package day_buttons

import "seek/internal/domain/models"
import "fmt"

templ DayButtons() {
	<div class="days-selector">
		for i := range models.Days {
			<label for={ models.Days[i].NameLower() }>
				{ models.Days[i].Short() }
				<input 
					data-bind={ fmt.Sprintf("days.%s", models.Days[i].NameLower()) } 
					name="days" 
					type="checkbox" 
					id={ models.Days[i].NameLower() } 
				/>
			</label>
		}
	</div>
	@DayButtonsStyle()
}

templ DayButtonsStyle() {
	<style>
		.days-selector {
			display: flex;
			flex-direction: row;
			gap: var(--size-0);
			justify-content: center;
			align-items: center;

			label {
				height: var(--size-8);
				display: flex;
				justify-content: center;
				align-items: center;
				font-size: var(--font-size--2);
				color: var(--secondary-3-on);
				background-color: var(--secondary-3);
				border-color: var(--secondary-4);
				border-radius: var(--border-radius-0);
				border-style: solid;
				border-width: var(--border-width--0);
				flex: 1;
				transition: all var(--anim-duration-fast) var(--anim-ease-standard);

				&:hover {
					color: var(--secondary-4-on);
					background-color: var(--secondary-4);
					border-color: var(--secondary-5);
					cursor: pointer;
					transform: scale(var(--anim-scale-up));
				}

				input {
					display: none;
				}

				&:has(input:checked) {
					color: var(--secondary-5-on);
					background-color: var(--secondary-5);
					border-color: var(--secondary-6);

					&:hover {
						color: var(--secondary-6-on);
						background-color: var(--secondary-6);
						border-color: var(--secondary-7);
					}
				}
			}
		}
	</style>
}