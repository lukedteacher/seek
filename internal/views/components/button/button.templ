package button

type Variant string
type Color string
type Size string
type Type string

const (
	VariantDefault     Variant = "default"
	VariantDestructive Variant = "destructive"
	VariantOutline     Variant = "outline"
	VariantSecondary   Variant = "secondary"
	VariantGhost       Variant = "ghost"
	VariantLink        Variant = "link"
)

const (
	ColorSuccess Color = "success"
	ColorInfo    Color = "info"
	ColorWarning Color = "warning"
	ColorError   Color = "error"
)

const (
	TypeButton Type = "button"
	TypeReset  Type = "reset"
	TypeSubmit Type = "submit"
)

const (
	SizeDefault Size = "default"
	SizeXs      Size = "xs"
	SizeSm      Size = "sm"
	SizeLg      Size = "lg"
	SizeIcon    Size = "icon"
	SizeIconXs  Size = "icon-xs"
	SizeIconSm  Size = "icon-sm"
	SizeIconLg  Size = "icon-lg"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Color      Color
	Variant    Variant
	Size       Size
	Href       string
	Target     string
	Disabled   bool
	Type       Type
	Form       string
}

templ Button(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = TypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	if p.Href != "" && !p.Disabled {
		<a
			if p.ID != "" {
				id={ p.ID }
			}
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			data-slot="button"
			if p.Color != "" {
				data-color={ string(p.Color) }
			}
			data-variant={ string(p.Variant) }
			data-size={ string(p.Size) }
			if p.Class != "" {
				class={ p.Class }
			}
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="button"
			if p.Color != "" {
				data-color={ string(p.Color) }
			}
			data-variant={ string(p.Variant) }
			data-size={ string(p.Size) }
			if p.Class != "" {
				class={ p.Class }
			}
			if p.Type != "" {
				type={ string(p.Type) }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			disabled?={ p.Disabled }
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}