package layouts

import (
	"seek/internal/features/users/models"
	"seek/internal/resources"
	"seek/internal/views"
	"seek/internal/views/blocks/header"
	"seek/internal/views/components"
)

templ Base(title string, user models.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script type="module" src={ resources.StaticPath("scripts/datastar.js") }></script>
			<script type="module" src={ resources.StaticPath("scripts/datastar-inspector.js") }></script>
			<link rel="stylesheet" href={ resources.StaticPath("styles/style.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/stellar.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/global.css") }/>
		</head>
		<body
			if views.IsDevelopment() {
				data-init={ views.HotReloadSSE() }
			}
		>
			@header.MainHeader(user)
			{ children... }
			@components.MainFooter()
		</body>
	</html>
}
