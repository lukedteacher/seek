package corepages

import (
	"fmt"
	scheduleBlocks "seek/internal/features/schedules/blocks"
	scheduleDTO "seek/internal/features/schedules/dto"
	studentDTO "seek/internal/features/students/dto"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/buttons"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

type DashboardView struct {
	Periods            []scheduleDTO.SchedulePeriodView
	PeriodStudentsMap  map[string][]studentDTO.StudentView
	BookmarkedStudents []studentDTO.StudentView
}

templ Dashboard(view DashboardView) {
	@corelayouts.LayoutBase("SEEK: dashboard") {
		<main class="flex flex-col gap-2 row-2" data-init={ sse.LongRunningGetSSE("/dashboard/stream") }>
			<div class="w-full h-full flex flex-col lg:grid lg:grid-cols-2 lg:grid-rows-1 gap-6">
				@DashboardSchedule(view.Periods, view.PeriodStudentsMap)
				@DashboardBookmarkedStudents(view.BookmarkedStudents)
			</div>
		</main>
	}
}

templ DashboardSchedule(periods []scheduleDTO.SchedulePeriodView, psmap map[string][]studentDTO.StudentView) {
	<section id="dashboard-schedule" class="flex flex-col gap-3">
		@corebuttons.FlexIconButton("/periods/create", "plus", "create")
		@scheduleBlocks.ScheduleComponent([]scheduleDTO.PersonWithScheduleView{}) {
			for _, period := range periods {
				@scheduleBlocks.EducatorPeriodCard(scheduleBlocks.EducatorPeriodCardProps{
					View:     period,
					Students: psmap[period.Period.ID],
				})
			}
		}
	</section>
}

templ DashboardBookmarkedStudents(students []studentDTO.StudentView) {
	<section class="flex flex-col gap-4">
		<div class="border-muted border rounded-md w-full h-fit bg-neutral text-sm p-4">
			<h3 class="flex items-center gap-2">
				@icon.GraduationCap()
				<span>bookmarked students</span>
			</h3>
		</div>
		if len(students) > 0 {
			<ul class="grid grid-cols-1 md:grid-cols-2 gap-1 overflow-y-auto">
				for _, student := range students {
					<li class="border border-muted rounded-md w-full bg-neutral-dark text-sm p-2 flex items-center justify-between">
						<div class="flex gap-2 items-center">
							@coreblocks.PersonAvatar("student", student.Person)
							<span>{ student.NameInitial() }</span>
							@badge.Badge() {
								{ student.Grade.Ordinal() }
							}
						</div>
						<div>
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Href:    fmt.Sprintf("/students/%s/info", student.Username),
							}) {
								@icon.Info()
							}
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Href:    fmt.Sprintf("/students/%s/schedule", student.Username),
							}) {
								@icon.CalendarRange()
							}
						</div>
					</li>
				}
			</ul>
		} else {
			none found
		}
	</section>
}
