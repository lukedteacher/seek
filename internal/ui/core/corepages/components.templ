package corepages

import (
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

templ Components() {
	@corelayouts.LayoutBase("SEEK: components") {
		<main style="display: flex; flex-direction: column; gap: 1rem;">
			@coreblocks.HeaderMain("components")
			<section>
				<h3>animated icons</h3>
				<svg class="login-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="28" height="28">
					<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
					<polyline points="10 17 15 12 10 7" class="move-part"></polyline>
					<line x1="3" x2="15" y1="12" y2="12" class="move-part"></line>
				</svg>
				<svg class="blocks-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="28" height="28">
					<path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"></path>
					<path class="block-move" d="M14 3h7v7h-7z"></path>
				</svg>
				<div class="brain-icon" role="img" aria-label="brain-cog">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 5a3 3 0 1 0-5.997.142 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588 4 4 0 0 0 7.636 2.106 3.2 3.2 0 0 0 .164-.546c.028-.13.306-.13.335 0a3.2 3.2 0 0 0 .163.546 4 4 0 0 0 7.636-2.106 4 4 0 0 0 .556-6.588 4 4 0 0 0-2.526-5.77A3 3 0 1 0 12 5"></path>
						<path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path>
						<path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path>
						<path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path>
						<path d="M19.938 10.5a4 4 0 0 1 .585.396"></path>
						<path d="M6 18a4 4 0 0 1-1.967-.516"></path>
						<path d="M19.967 17.484A4 4 0 0 1 18 18"></path>
						<g class="cog-group">
							<circle cx="12" cy="12" r="3"></circle>
							<path d="m15.7 10.4-.9.4"></path>
							<path d="m9.2 13.2-.9.4"></path>
							<path d="m13.6 15.7-.4-.9"></path>
							<path d="m10.8 9.2-.4-.9"></path>
							<path d="m15.7 13.5-.9-.4"></path>
							<path d="m9.2 10.9-.9-.4"></path>
							<path d="m10.5 15.7.4-.9"></path>
							<path d="m13.1 9.2.4-.9"></path>
						</g>
					</svg>
				</div>
			</section>
			<style>
				@keyframes bounce-right {
					0%   { transform: translateX(0); }
					30%  { transform: translateX(3px); }
					70%  { transform: translateX(0); }
					100% { transform: translateX(0); }
				}
				.login-icon:hover .move-part {
					animation: bounce-right 500ms var(--anim-ease-standard);
				}
				.block-move {
					transition: transform 0.2s ease;
				}
				.blocks-icon:hover .block-move {
					transform: translate(-4px, 4px);
				}
				.brain-icon {
					display: inline-block;
				}
				.cog-group {
					transform-origin: 12px 12px;
					transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
				}
				.brain-icon:hover .cog-group {
					transform: rotate(180deg);
				}
			</style>
			<section>
				<h3>buttons</h3>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(4, 1fr) / repeat(4, 1fr); gap: var(--size-0);">
					@button.Button() {
						default
					}
					@button.Button(button.Props{
						Variant: button.VariantOutline,
					}) {
						outline
					}
					@button.Button(button.Props{
						Variant: button.VariantGhost,
					}) {
						ghost
					}
					@button.Button(button.Props{
						Variant: button.VariantLink,
					}) {
						link
					}
					@button.Button(button.Props{
						Size: button.SizeIcon,
					}) {
						@icon.Bomb(icon.Props{
							Size: "16",
						})
					}
				</div>
			</section>
			<section>
				<h3>icons</h3>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(8, 1fr) / repeat(8, 1fr); gap: var(--size-0);">
					@icon.Bomb(icon.Props{
						Size: "16",
					})
					@icon.Clock()
					@icon.LogIn()
					@icon.Sailboat()
				</div>
			</section>
			<section>
				<div style="margin-top: 1rem; display: grid; grid-template: repeat(4, 1fr) / repeat(4, 1fr); gap: var(--size-0);">
					<h3>badges</h3>
					@badge.Badge() {
						default
					}
					@badge.Badge(badge.Props{
						Variant: badge.VariantSecondary,
					}) {
						secondary
					}
					@badge.Badge(badge.Props{
						Variant: badge.VariantDestructive,
					}) {
						destructive
					}
				</div>
			</section>
		</main>
	}
}
