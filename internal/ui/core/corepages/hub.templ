package corepages

import (
	"seek/internal/ui/core/corelayouts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/card"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/separator"
)

type HubCardProps struct {
	icon        string
	title       string
	description string
	links       []linkProps
}

type linkProps struct {
	href     string
	text     string
	linkType string
}

templ Hub() {
