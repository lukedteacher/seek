						linkProps{
							text:     "K/1 Gretchen / Annie",
							href:     "https://docs.google.com/document/d/1Ew20WVhcthcfSS15-fYVZRbbFjsHepnZDHxLNkqj7rU",
							linkType: "file-type-corner",
						},
						linkProps{
