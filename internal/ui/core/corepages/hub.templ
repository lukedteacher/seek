templ HubCard(props HubCardProps) {
	@card.Card(card.Props{
		Class: "flex flex-col border-muted bg-linear-23 accent-blue",
	}) {
		@card.Header() {
			@card.Title() {
				@icon.Icon(props.icon)(icon.Props{Size: "20"})
				{ props.title }
			}
			@card.Description() {
				{ props.description }
			}
			@separator.Separator(separator.Props{
				Class: "mt-1",
			})
		}
		@card.Content(card.ContentProps{
			Class: "text-sm py-5",
		}) {
			<ul class="flex flex-col gap-1">
				for _, link := range props.links {
					<a href={ link.href } target="_blank">
						<li class="flex justify-between items-center hover:bg-primary/20 py-1 px-2 rounded-md">
							<span>{ link.text }</span>
							if link.linkType != "" {
								@icon.Icon(link.linkType)(icon.Props{Class: "size-4"})
							}
						</li>
					</a>
				}
			</ul>
		}
	}
}
