package coreblocks

import (
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/separator"
)

templ HeaderMain(title string) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<header class="w-full md:px-3 display flex flex-col gap-3 mb-4">
		@Breadcrumbs(url)
		@separator.Separator(separator.Props{
			Class: "mb-3",
		})
		<h2>{ title }</h2>
	</header>
}
