package coreblocks

import "seek/pkg/templui/components/icon"
import "seek/internal/features/_shared/sharedmodels"

type NavItem struct {
	Label    string
	IconName string
	HREF     string
}

var NavItems = []NavItem{
	NavItem{
		Label:    "home",
		IconName: "house",
		HREF:     "/",
	},
	NavItem{
		Label:    "dashboard",
		IconName: "layout-dashboard",
		HREF:     "/dashboard",
	},
	NavItem{
		Label:    "hub",
		IconName: "circle-question-mark",
		HREF:     "/hub",
	},
}

templ Nav() {
	<nav>
		<ul>
			for _, item := range NavItems {
				@NavItemLink(item)
			}
		</ul>
	</nav>
}

templ NavItemLink(item NavItem) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	<li data-active={ item.HREF == url }>
		<a href={ item.HREF }>
			@icon.Icon(item.IconName)(icon.Props{
				Size: "20",
			})
			<span class="hidden sm:block">{ item.Label }</span>
		</a>
	</li>
}
