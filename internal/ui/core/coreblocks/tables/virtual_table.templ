package tables

import (
	"fmt"
	"strings"

	"seek/internal/features/_shared/shareddto"
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/collapsible"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/skeleton"
)

templ VirtualDataTable(
	view shareddto.TableView, 
	scrollAction string,
	topSpacerPx, 
	bottomSpacerPx int,
) {
	<style>
		.vt-wrap {
			display: flex;
			flex-direction: column;
			width: 100%;
			max-height: 100%;
			height: fit-content;
			margin: 0 auto;
			overflow: hidden;
			border: 1px solid var(--color-neutral-dim);
			border-radius: 0.375rem;
		}
		.vt-scroll {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			position: relative;
		}
		.vt-header {
			position: sticky;
			top: 0;
			z-index: 20;
			background-color: var(--color-neutral-dark);
			border-bottom: 1px solid var(--color-neutral-dim);
		}
		.vt-header-grid {
			display: grid;
			grid-auto-rows: 44px;
			align-items: center;
		}
		.vt-th {
			padding: 0 0.75rem;
			font-weight: 600;
			font-size: 0.875rem;
			overflow: hidden;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
		}
		.vt-th span {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.vt-th-group {
			justify-content: center;
			color: var(--color-neutral-content);
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.vt-th-actions {
			justify-content: center;
		}
		.vt-row {
			display: grid;
			align-items: center;
			height: 44px;
			border-top: 1px solid var(--color-neutral-dim);
			box-sizing: border-box;
		}
		.vt-row:hover {
			background: color-mix(in oklch, var(--color-primary) 20%, transparent);
			box-shadow: inset 0 0 0 1px var(--color-primary);
		}
		.vt-cell {
			padding: 0 0.75rem;
			font-size: 0.875rem;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.vt-cell.text-center { text-align: center; }
		.vt-cell.text-right { text-align: right; }
		.vt-actions {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.25rem;
			padding: 0 0.5rem;
		}
		.vt-group-row {
			display: flex;
			align-items: center;
			height: 44px;
			padding: 0 1.5rem;
			background-color: color-mix(in oklch, var(--color-secondary), transparent);
			font-size: 1.0rem;
			letter-spacing: 0.05em;
			font-weight: 700;
			border-top: 1px solid var(--color-muted);
		}
		.vt-subrow {
			background: color-mix(in oklch, var(--color-muted) 20%, transparent);
			border-top: 1px solid var(--color-muted);
		}
		.vt-spacer { display: block; }
		.vt-row.row--flash { animation: row-flash 2s ease-out; }
		@keyframes row-flash {
			0% { background-color: color-mix(in oklch, var(--color-primary) 20%, transparent); }
			100% { background-color: transparent; }
		}
		.vt-sort-active { background: var(--color-primary); }
	</style>
	<div class="vt-wrap">
		@virtualHeader(view)
		<div
			id="vt-scroll"
			class="vt-scroll"
			data-init={ fmt.Sprintf("$lastStart = 0; $viewport_height = Math.round(el.clientHeight); $scroll_top = Math.round(el.scrollTop); %s", scrollAction) }
			data-on:scroll={ fmt.Sprintf("$visibleStart = Math.floor(el.scrollTop / 44); if ($visibleStart != $lastStart) { $lastStart = $visibleStart; $scroll_top = Math.round(el.scrollTop); $viewport_height = Math.round(el.clientHeight); %s }", scrollAction) }
		>
			if topSpacerPx > 0 {
				<div id="vt-top-spacer" class="vt-spacer" style={ fmt.Sprintf("height: %dpx", topSpacerPx) }></div>
			}
			@virtualRows(view)
			if bottomSpacerPx > 0 {
				<div id="vt-bottom-spacer" class="vt-spacer" style={ fmt.Sprintf("height: %dpx", bottomSpacerPx) }></div>
			}
		</div>
	</div>
}

templ virtualHeader(view shareddto.TableView) {
	<div class="vt-header">
		<div class="vt-header-grid" style={ fmt.Sprintf("grid-template-columns: repeat(%d, minmax(0, 1fr)) 80px", len(view.Columns)) }>
			{{ colIdx := 1 }}
			{{ renderedGroups := make(map[string]bool) }}
			for _, col := range view.Columns {
				if col.Group == "" {
					<div id={ "vt-h-" + col.Signal } class="vt-th" style={ fmt.Sprintf("grid-row: span 2; grid-column: %d", colIdx) }>
						<span>{ col.Display }</span>
						if col.Sortable {
							@virtualSortButton(col, view.Sort)
						}
					</div>
					{{ colIdx++ }}
				} else if !renderedGroups[col.Group] {
					{{ renderedGroups[col.Group] = true }}
					{{ span := virtualCountColumnsInGroup(view.Columns, col.Group) }}
					<div id={ "vt-hg-" + col.Group } class="vt-th vt-th-group" style={ fmt.Sprintf("grid-row: 1; grid-column: %d / span %d", colIdx, span) }>
						{ col.Group }
					</div>
					{{ colIdx += span }}
				}
			}
			<div id="vt-h-actions" class="vt-th vt-th-actions" style={ fmt.Sprintf("grid-row: span 2; grid-column: %d", colIdx) }>actions</div>
			{{ subIdx := 1 }}
			for _, col := range view.Columns {
				if col.Group != "" {
					<div id={ "vt-h2-" + col.Signal } class="vt-th" style={ fmt.Sprintf("grid-row: 2; grid-column: %d", subIdx) }>
						<span>{ col.Display }</span>
						if col.Sortable {
							@virtualSortButton(col, view.Sort)
						}
					</div>
				}
				{{ subIdx++ }}
			}
		</div>
	</div>
}

templ virtualRows(view shareddto.TableView) {
	if len(view.Rows) > 0 {
		{{ currentGroup := "" }}
		for i := range view.Rows {
			if view.Rows[i].Group != "" && view.Rows[i].Group != currentGroup {
				<div id={ "vt-group-" + view.Rows[i].Group } class="vt-group-row">
					{ view.Rows[i].Group }
				</div>
				{{ currentGroup = view.Rows[i].Group }}
			}
			@virtualRow(view.Name, view.Columns, view.Rows[i])
			if view.Rows[i].SubTable != nil && len(view.Rows[i].SubTable.Rows) > 0 {
				<div id={ "vt-sub-" + view.Rows[i].Target } class="vt-subrow">
					@collapsible.Script()
					@collapsible.Collapsible() {
						@collapsible.Trigger(collapsible.TriggerProps{
							Class: "flex gap-2 items-center px-4 py-2 justify-end",
						}) {
							services
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-8",
							}) {
								@icon.ChevronDown(icon.Props{Class: "size-4"})
							}
						}
						@collapsible.Content() {
							@virtualRows(*view.Rows[i].SubTable)
						}
					}
				</div>
			}
		}
	} else {
		for i := 0; i < 5; i++ {
			@virtualSkeletonRow(view.Columns)
		}
	}
}

templ virtualRow(target string, columns []shareddto.ColumnView, row shareddto.RowView) {
	{{ class := "vt-row" }}
	{{
		if virtualIsFresh(row.Item) {
			class += " row--flash"
		}
	}}
	<div id={ "vt-row-" + row.Target } class={ class } style={ fmt.Sprintf("grid-template-columns: repeat(%d, minmax(0, 1fr)) 80px", len(columns)) }>
		for i := range row.Cells {
			<div class={ "vt-cell", virtualAlignmentClass(columns[i].Alignment) }>
				if columns[i].RenderFunc != nil {
					@columns[i].RenderFunc(row.Item)
				} else if columns[i].Renderer == "badge" {
					if row.Cells[i] != "" {
						@virtualBadgeCell(columns[i].Field, row.Cells[i])
					} else {
						-
					}
				} else {
					{ row.Cells[i] }
				}
			</div>
		}
		<div class="vt-actions">
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Href:    fmt.Sprintf("/%s/%s", target, row.Target),
			}) {
				@icon.Eye(icon.Props{Size: "16"})
			}
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Href:    fmt.Sprintf("/%s/%s/edit", target, row.Target),
			}) {
				@icon.Pencil(icon.Props{Size: "16"})
			}
		</div>
	</div>
}

templ virtualBadgeCell(field string, value shareddto.CellView) {
	if field == "ServiceType" {
		@badge.Badge(badge.Props{
			Attributes: templ.Attributes{"data-service": value.String()},
		}) {
			@icon.Icon(sharedmodels.ServiceType(value.String()).IconName())(icon.Props{Class: "mr-1 size-12"})
			{ value }
		}
	} else if field == "Roles" {
		{{ roles := strings.Split(string(value), ",") }}
		<span class="flex flex-wrap justify-center items-center gap-2">
			for _, role := range roles {
				@badge.Badge() {
					{ role }
				}
			}
		</span>
	} else {
		@badge.Badge() {
			{ value }
		}
	}
}

templ virtualSkeletonRow(columns []shareddto.ColumnView) {
	<div class="vt-row" style={ fmt.Sprintf("grid-template-columns: repeat(%d, minmax(0, 1fr)) 80px", len(columns)) }>
		for i := range columns {
			<div class={ "vt-cell", virtualAlignmentClass(columns[i].Alignment) }>
				<div class="flex justify-center items-center">
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full max-w-24"})
				</div>
			</div>
		}
		<div class="vt-actions">
			@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
			@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
		</div>
	</div>
}

templ virtualSortButton(column shareddto.ColumnView, sort shareddto.TableSort) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf(
				"if ($table.sort.column == '%[1]s') { $table.sort.direction = $table.sort.direction == 'ASC' ? 'DESC' : 'ASC'; } else { $table.sort.column = '%[1]s'; $table.sort.direction = 'ASC'; } $scroll_top = 0; $lastStart = 0; @query('%[2]s')",
				column.Signal, url,
			),
			"data-class:vt-sort-active": fmt.Sprintf("$table.sort.column == '%s'", column.Signal),
		},
	}) {
		if sort.Column == column.Signal {
			if sort.Direction == "ASC" {
				@icon.ArrowUp(icon.Props{Class: "text-neutral-content"})
			} else {
				@icon.ArrowDown(icon.Props{Class: "text-neutral-content"})
			}
		} else {
			@icon.ArrowUpDown()
		}
	}
}

func virtualIsFresh(item any) bool {
	if f, ok := item.(interface{ IsFresh() bool }); ok {
		return f.IsFresh()
	}
	return false
}

func virtualCountColumnsInGroup(columns []shareddto.ColumnView, group string) int {
	count := 0
	for _, col := range columns {
		if col.Group == group {
			count++
		}
	}
	return count
}

func virtualAlignmentClass(alignment string) string {
	switch alignment {
	case "center":
		return "text-center"
	case "right":
		return "text-right"
	}
	return ""
}
