package tables

import (
	"fmt"
	"strings"

	"seek/internal/features/_shared/shareddto"
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/collapsible"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/skeleton"
	"seek/pkg/templui/components/table"
	"seek/pkg/utils"
)

templ DataTable(view shareddto.TableView) {
	<section
		data-slot="data-table"
		class="flex flex-col w-full max-h-full h-fit ml-auto mr-auto overflow-hidden rounded-md border border-muted"
	>
		<div class="flex-1 min-h-0 overflow-y-auto snap-y snap-proximity scroll-pbs-24">
			@Table(view)
		</div>
	</section>
}

templ Table(view shareddto.TableView) {
	@table.Table(table.Props{
		Class: "data-table",
	}) {
		@Header(view)
		@table.Body() {
			if len(view.Rows) > 0 {
				{{ currentGroup := "" }}
				for i := range view.Rows {
					if view.Rows[i].Group != "" && view.Rows[i].Group != currentGroup {
						@GroupRowHeader(len(view.Columns), view.Rows[i].Group)
						{{ currentGroup = view.Rows[i].Group }}
					}
					@Row(view.Name, view.Columns, view.Rows[i])
					if view.Rows[i].SubTable != nil {
						if len(view.Rows[i].SubTable.Rows) > 0 {
							<tr>
								<td colspan={ len(view.Columns) + 1 } class="p-0 bg-muted/20">
									@collapsible.Script()
									@collapsible.Collapsible() {
										@collapsible.Trigger(collapsible.TriggerProps{
											Class: "flex gap-2 items-center px-4 py-2 justify-end",
										}) {
											services
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-8",
											}) {
												@icon.ChevronDown(icon.Props{
													Class: "size-4",
												})
											}
										}
										@collapsible.Content() {
											@Table(*view.Rows[i].SubTable)
										}
									}
								</td>
							</tr>
						}
					}
				}
			} else {
				// skeleton rows – adjust count as needed
				for i := 0; i < 5; i++ {
					@SkeletonRow(view.Columns)
				}
			}
		}
	}
}

templ Header(view shareddto.TableView) {
	@table.Header(table.HeaderProps{
		Class: "sticky top-0 z-20 h-24",
	}) {
		// first row: status (rowspan=2) + group headers and ungrouped headers
		@HeaderRowFirst(view)
		// second row: individual headers only for grouped columns
		@HeaderRowSecond(view)
	}
}

templ HeaderRowFirst(view shareddto.TableView) {
	@table.Row() {
		{{ renderedGroups := make(map[string]bool) }}
		for _, col := range view.Columns {
			if col.Group == "" {
				@table.Head(table.HeadProps{
					Class: "text-center",
					Attributes: templ.Attributes{
						"rowspan": 2,
					},
				}) {
					<div class="flex justify-between items-center">
						<span>{ col.Display }</span>
						if col.Sortable {
							@SortButton(col, view.Sort)
						}
					</div>
				}
			} else {
				if !renderedGroups[col.Group] {
					{{ renderedGroups[col.Group] = true }}
					{{ count := countColumnsInGroup(view.Columns, col.Group) }}
					@table.Head(table.HeadProps{
						Class: "text-center",
						Attributes: templ.Attributes{
							"colspan": count,
						},
					}) {
						{ col.Group }
					}
				}
			}
		}
		@table.Head(table.HeadProps{
			Class: "text-center",
			Attributes: templ.Attributes{
				"rowspan": 2,
			},
		}) {
			actions 
		}
	}
}

templ HeaderRowSecond(view shareddto.TableView) {
	@table.Row() {
		{{ seenUngrouped := false }}
		{{ firstGrouped := true }}
		for _, col := range view.Columns {
			if col.Group == "" {
				{{ seenUngrouped = true }}
			} else {
				{{
					class := utils.TwMerge(
						"text-center border-dashed border-muted",
						utils.If(!firstGrouped, "not-first:border-l"),
						utils.If(firstGrouped && seenUngrouped, "border-l"),
					)
				}}
				@table.Head(table.HeadProps{
					Class: class,
				}) {
					<div class="flex justify-between items-center">
						<span>{ col.Display }</span>
						if col.Sortable {
							@SortButton(col, view.Sort)
						}
					</div>
				}
				{{ firstGrouped = false }}
			}
		}
	}
}

templ SkeletonRow(columns []shareddto.ColumnView) {
	@table.Row(table.RowProps{
		Class: "hover:bg-primary/20 border-1 border-muted",
	}) {
		for i := range columns {
			@table.Cell(table.CellProps{
				Class: fmt.Sprintf("not-first:border-l border-dashed border-muted text-%s", columns[i].Alignment),
			}) {
				<div class="flex justify-center items-center">
					@skeleton.Skeleton(skeleton.Props{
						Class: "h-4 w-full max-w-24",
					})
				</div>
			}
		}
		@table.Cell(table.CellProps{
			Class: "border-l border-dashed border-muted text-center w-min",
		}) {
			<div class="flex gap-2 justify-center">
				@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
				@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
			</div>
		}
	}
}

templ GroupRowHeader(colspan int, label string) {
	<tr class="">
		<td colspan={ colspan } class="bg-primary-dim uppercase px-6 py-3 sticky top-24 z-10 snap-start">
			<h3>{ label }</h3>
		</td>
	</tr>
}

templ Row(target string, columns []shareddto.ColumnView, row shareddto.RowView) {
	@table.Row(table.RowProps{
		Class: "hover:bg-primary/20 snap-start",
	}) {
		for i := range row.Cells {
			<td class={ utils.If(columns[i].Alignment != "", fmt.Sprintf("text-%s", columns[i].Alignment)) }>
				if columns[i].RenderFunc != nil {
					@columns[i].RenderFunc(row.Item)
				} else if columns[i].Renderer == "badge" {
					if row.Cells[i] != "" {
						@BadgeCellContent(columns[i].Field, row.Cells[i])
					} else {
						-
					}
				} else {
					{ row.Cells[i] }
				}
			</td>
		}
		@ActionCell(target, row.Target)
	}
}

templ BadgeCellContent(field string, value shareddto.CellView) {
	if field == "ServiceType" {
		@badge.Badge(badge.Props{
			Attributes: templ.Attributes{
				"data-service": value.String(),
			},
		}) {
			@icon.Icon(sharedmodels.ServiceType(value.String()).IconName())(icon.Props{Class: "mr-1 size-12"})
			{ value }
		}
	} else if field == "Roles" {
		{{ roles := strings.Split(string(value), ",") }}
		<span class="flex flex-wrap justify-center items-center gap-2">
			for _, role := range roles {
				@badge.Badge() {
					{ role }
				}
			}
		</span>
	} else {
		@badge.Badge() {
			{ value }
		}
	}
}

templ ActionCell(target, rowID string) {
	@table.Cell(table.CellProps{
		Class: "text-center w-fit",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Href:    fmt.Sprintf("/%s/%s", target, rowID),
		}) {
			@icon.Eye(icon.Props{
				Size: "16",
			})
		}
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Href:    fmt.Sprintf("/%s/%s/edit", target, rowID),
		}) {
			@icon.Pencil(icon.Props{
				Size: "16",
			})
		}
	}
}

templ SortButton(column shareddto.ColumnView, sort shareddto.TableSort) {
	{{ url := sharedmodels.GetURLFromContext(ctx) }}
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf(
				"if ($table.sort.column == '%[1]s') { $table.sort.direction = $table.sort.direction == 'ASC' ? 'DESC' : 'ASC'; } else { $table.sort.column = '%[1]s'; $table.sort.direction = 'ASC'; } @query('%[2]s')",
				column.Signal, url,
			),
			"data-class:bg-primary": fmt.Sprintf("$table.sort.column == '%s'", column.Signal),
			"style":                 "margin-left: auto;",
		},
	}) {
		if sort.Column == column.Signal {
			if sort.Direction == "ASC" {
				@icon.ArrowUp(icon.Props{
					Class: "text-neutral-content",
				})
			} else {
				@icon.ArrowDown(icon.Props{
					Class: "text-neutral-content",
				})
			}
		} else {
			@icon.ArrowUpDown()
		}
	}
}
