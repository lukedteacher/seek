package tables

import (
	"fmt"

	"seek/internal/features/_shared/shareddto"
	"seek/internal/features/_shared/sharedmodels"
	"seek/pkg/templui/components/badge"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
	"seek/pkg/templui/components/skeleton"
	"seek/pkg/templui/components/table"
)

templ DataTable(view shareddto.TableView) {
	<section data-slot="data-table" class="w-full ml-auto mr-auto">
		@Table(view)
	</section>
	<style>
		section[data-slot="data-table"] {
			max-width: 72rem;

			& >:not(:last-child) {
				margin-block-end: 1rem;
			}
		}
	</style>
}

templ Table(view shareddto.TableView) {
	@table.Table(table.Props{
		Class: "data-table",
	}) {
		@Header(view)
		@table.Body() {
			if len(view.Rows) > 0 {
				for i := range view.Rows {
					@Row(view.Name, view.Columns, view.Rows[i])
				}
			} else {
				// skeleton rows – adjust count as needed
				for i := 0; i < 5; i++ {
					@SkeletonRow(view.Columns)
				}
			}
		}
	}
}

templ Header(view shareddto.TableView) {
	@table.Header() {
		// first row: status (rowspan=2) + group headers and ungrouped headers
		@table.Row() {
			{{ renderedGroups := make(map[string]bool) }}
			for _, col := range view.Columns {
				if col.Group == "" {
					@table.Head(table.HeadProps{
						Class: "text-center not-first:border-l border-dashed border-muted",
						Attributes: templ.Attributes{
							"rowspan": 2,
						},
					}) {
						{ col.Display }
					}
				} else {
					if !renderedGroups[col.Group] {
						{{ renderedGroups[col.Group] = true }}
						{{ count := countColumnsInGroup(view.Columns, col.Group) }}
						@table.Head(table.HeadProps{
							Class: "text-center not-first:border-l border-b border-dashed border-muted",
							Attributes: templ.Attributes{
								"colspan": count,
							},
						}) {
							{ col.Group }
						}
					}
				}
			}
			@table.Head(table.HeadProps{
				Class: "text-center border-l border-dashed border-muted",
				Attributes: templ.Attributes{
					"rowspan": 2,
				},
			}) {
				actions 
			}
		}
		// second row: individual headers only for grouped columns
		@table.Row() {
			{{ seenUngrouped := false }}
			{{ firstGrouped := true }}
			for _, col := range view.Columns {
				if col.Group == "" {
					{{ seenUngrouped = true }}
				} else {
					{{ class := "text-center border-dashed border-muted" }}
					if firstGrouped && seenUngrouped {
						{{ class += " border-l" }}
					}
					if !firstGrouped {
						{{ class += " not-first:border-l" }}
					}
					@table.Head(table.HeadProps{Class: class}) {
						{ col.Display }
					}
					{{ firstGrouped = false }}
				}
			}
		}
	}
}

templ SkeletonRow(columns []shareddto.ColumnView) {
	@table.Row(table.RowProps{
		Class: "hover:bg-primary/20 border-1 border-muted",
	}) {
		for i := range columns {
			@table.Cell(table.CellProps{
				Class: fmt.Sprintf("not-first:border-l border-dashed border-muted text-%s", columns[i].Alignment),
			}) {
				<div class="flex justify-center items-center">
					@skeleton.Skeleton(skeleton.Props{
						Class: "h-4 w-full max-w-24",
					})
				</div>
			}
		}
		@table.Cell(table.CellProps{
			Class: "border-l border-dashed border-muted text-center w-min",
		}) {
			<div class="flex gap-2 justify-center">
				@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
				@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
			</div>
		}
	}
}

templ Row(target string, columns []shareddto.ColumnView, row shareddto.RowView) {
	@table.Row(table.RowProps{
		Class: "hover:bg-primary/20 border-1 border-muted",
	}) {
		for i := range row.Cells {
			@table.Cell(table.CellProps{
				Class: fmt.Sprintf("not-first:border-l border-dashed border-muted text-%s", columns[i].Alignment),
			}) {
				if columns[i].Renderer == "badge" && row.Cells[i] != "" {
					@BadgeCellContent(columns[i].Field, row.Cells[i])
				} else {
					{ row.Cells[i] }
				}
			}
		}
		@ActionCell(target, row.Target)
	}
}

templ BadgeCellContent(field string, value shareddto.CellView) {
	if field == "ServiceType" {
		@badge.Badge(badge.Props{
			Attributes: templ.Attributes{
				"data-service": value.String(),
			},
		}) {
			@icon.Icon(sharedmodels.ServiceType(value.String()).IconName())(icon.Props{Class: "mr-1 size-12"})
			{ value }
		}
	} else {
		@badge.Badge() {
			{ value }
		}
	}
}

templ ActionCell(target, rowID string) {
	@table.Cell(table.CellProps{
		Class: "border-l border-dashed border-muted text-center w-min",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Href:    fmt.Sprintf("/%s/%s", target, rowID),
		}) {
			@icon.Eye(icon.Props{
				Size: "16",
			})
		}
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Href:    fmt.Sprintf("/%s/%s/edit", target, rowID),
		}) {
			@icon.Pencil(icon.Props{
				Size: "16",
			})
		}
	}
}

templ SortButton(column string) {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Attributes: templ.Attributes{
			"data-on:click": "$table." + column + "=!$table." + column + "; @post('/sort')",
			"style":         "margin-left: auto;",
		},
	}) {
		@icon.ArrowUpDown(icon.Props{
			Size: "16",
		})
	}
}
