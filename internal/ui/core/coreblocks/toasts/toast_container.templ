package toasts

import "seek/internal/features/_shared/sharedmodels"

templ Container(list []sharedmodels.Toast) {
	if len(list) > 0 {
		<div class="toasts" aria-live="polite">
			for _, t := range list {
				@Toast(t)
			}
		</div>
	}
}

templ Toast(t sharedmodels.Toast) {
	<div class={ "toast", "toast--" + t.Kind } role="status">
		<span class="toast__message">{ t.Message }</span>
		<button
			type="button"
			class="toast__dismiss"
			aria-label="dismiss"
			data-on:click={ "@delete('/toasts/" + t.ID + "')" }
		>×</button>
	</div>
}
