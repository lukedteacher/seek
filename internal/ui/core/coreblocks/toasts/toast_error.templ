package toasts

import "seek/pkg/templui/components/toast"

templ ToastError(errorString string) {
	@toast.Toast(toast.Props{
		ID:            "toast",
		Description:   errorString,
		Variant:       toast.VariantError,
		Position:      toast.PositionTopCenter,
		Duration:      501,
		Dismissible:   true,
		ShowIndicator: true,
	})
}
