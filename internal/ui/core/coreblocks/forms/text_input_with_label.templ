package forms

import (
	"fmt"

	"seek/pkg/templui/components/input"
	"seek/pkg/templui/components/label"
)

templ TextInputWithLabel(id, labelText, url, bind, value string) {
	@label.Label(label.Props{
		ID:  "label" + id,
		For: "input" + id,
	}) {
		{ labelText }
	}
	@input.Input(input.Props{
		ID:    "input" + id,
		Name:  id,
		Type:  input.TypeText,
		Value: value,
		Attributes: templ.Attributes{
			"data-bind":     bind,
			"data-on:input": fmt.Sprintf("@post('%s')", url),
		},
	})
}
