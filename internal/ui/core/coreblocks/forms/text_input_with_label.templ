package forms

import (
	"fmt"

	"seek/pkg/templui/components/label"
	"seek/pkg/utils"
)

type TextInputWithLabelProps struct {
	ID        string
	LabelText string
	Value     string
	Bind      string
	URL       string
}

templ TextInputWithLabel(p TextInputWithLabelProps) {
	<div class="flex flex-col">
		@label.Label(label.Props{
			ID:    fmt.Sprintf("%s-label", p.ID),
			For:   fmt.Sprintf("%s-input", p.ID),
			Class: "mb-3 text-neutral-content/90",
		}) {
			{ p.LabelText }
		}
		<input
			id={ fmt.Sprintf("%s-input", p.ID) }
			class="input"
			name={ p.ID }
			type="text"
			data-bind={ p.Bind }
			{ utils.OnInput(utils.QueryValidate(p.URL)) }
		/>
	</div>
}
