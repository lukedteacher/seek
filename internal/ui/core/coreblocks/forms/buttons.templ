package forms

import (
	"fmt"

	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

type CancelButtonProps struct {
	CancelURL string
}

templ CancelButton(p CancelButtonProps) {
	<a class="button" href={ p.CancelURL } data-variant="warning">
		@icon.X(icon.Props{
			Size: "16",
		})
		<span>cancel</span>
	</a>
}

templ SaveButton() {
	<button type="submit" class="button" data-variant="success">
		@icon.Save(icon.Props{
			Size: "16",
		})
		<span>save</span>
	</button>
}

type ArchiveButtonProps struct {
	ArchiveURL string
}

templ ArchiveButton(p ArchiveButtonProps) {
	@button.Button(button.Props{
		Type:  "button",
		Class: "btn-info flex-grow basis-1",
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/%s/archive')", p.ArchiveURL),
		},
	}) {
		@icon.Archive(icon.Props{
			Size: "16",
		})
		<span>archive</span>
	}
}

type DeleteButtonProps struct {
	DeleteURL string
}

templ DeleteButton(p DeleteButtonProps) {
	<button
		class="button"
		type="button"
		data-variant="destructive"
		data-on:click={ fmt.Sprintf("@delete('%s')", p.DeleteURL) }
	>
		@icon.Trash(icon.Props{
			Size: "16",
		})
		<span>delete</span>
	</button>
}
