package forms

import (
	"fmt"
	"seek/pkg/templui/components/button"
	"seek/pkg/templui/components/icon"
)

templ CancelButton(href string) {
	@button.Button(button.Props{
		Type:  "button",
		Href:  href,
		Class: "btn-warning flex-grow basis-1",
	}) {
		@icon.X(icon.Props{
			Size: "16",
		})
		<span>cancel</span>
	}
}

templ SaveButton() {
	@button.Button(button.Props{
		Type:  "submit",
		Class: "flex-grow basis-1 btn-success bg-success/80 hover:bg-success/90 active:bg-success",
	}) {
		@icon.Save(icon.Props{
			Size: "16",
		})
		<span>save</span>
	}
}

templ ArchiveButton(object, id string) {
	@button.Button(button.Props{
		Type:  "button",
		Class: "btn-info flex-grow basis-1",
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/%s/%s/archive'", object, id),
		},
	}) {
		@icon.Archive(icon.Props{
			Size: "16",
		})
		<span>archive</span>
	}
}

templ DeleteButton(object, id string) {
	@button.Button(button.Props{
		Type:  "button",
		Class: "btn-destructive flex-grow basis-1",
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("@post('/%s/%s'", object, id),
		},
	}) {
		@icon.Trash(icon.Props{
			Size: "16",
		})
		<span>delete</span>
	}
}
