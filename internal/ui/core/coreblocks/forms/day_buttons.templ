package forms

import (
	"fmt"
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/periods/dto"
	"seek/pkg/templui/components/label"
)

templ DayButtons(view dto.PeriodFormView) {
	<div class="flex flex-col">
		@label.Label(label.Props{
			Class: "mb-3 text-muted-foreground",
		}) {
			days
		}
		<div class="days-selector flex justify-center items-center radius-md h-full">
			for i := range sharedmodels.Days {
				<label
					for={ sharedmodels.Days[i].NameLower() }
					class="first:rounded-l-md last:rounded-r-md flex border border-muted bg-neutral hover:bg-primary/80 active:bg-primary/90 justify-center items-center text-xs has-checked:bg-primary has-checked:hover:bg-primary/50 h-10 aspect-square"
				>
					{ sharedmodels.Days[i].Short() }
					<input
						hidden
						data-bind={ fmt.Sprintf("period.days.%s", sharedmodels.Days[i].NameLower()) }
						name="days"
						type="checkbox"
						id={ sharedmodels.Days[i].NameLower() }
						class="h-12"
						if view.Days.IsDaySet(sharedmodels.Days[i]) {
							checked
						}
						data-on:change={ fmt.Sprintf("@post('%s/validate')", view.URL) }
					/>
				</label>
			}
		</div>
	</div>
}
