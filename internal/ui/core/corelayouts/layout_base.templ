package corelayouts

import (
	"seek/internal/features/_shared/sharedmodels"
	"seek/internal/features/users/models"
	"seek/internal/resources"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/toasts"
	"seek/pkg/sse"
)

type Props struct {
	Title  string
	Toasts []sharedmodels.Toast
}

// LayoutBase is the string-only shim for pages not yet on props.
templ LayoutBase(title string) {
	@LayoutBaseWithProps(Props{Title: title}) {
		{ children... }
	}
}

templ LayoutBaseWithProps(props Props) {
	{{ user := models.GetUserFromContext(ctx) }}
	<!DOCTYPE html>
	<html lang="en" data-attr:data-theme="$theme">
		<head>
			<script>
				if (localStorage.getItem('theme') === null) {
					document.documentElement.setAttribute('data-theme', 'light');
					localStorage.setItem('theme', 'light')
				} else {
					document.documentElement.setAttribute(
						'data-theme',
						localStorage.getItem('theme')
					);
				}
			</script>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.Title }</title>
			<script type="module" src={ resources.StaticPath("scripts/datastar-rocket.js") }></script>
			<link rel="stylesheet" href={ resources.StaticPath("styles/reset.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/base.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/theme.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/components.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/utilities.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/style.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/stellar.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/global.css") }/>
			<script src="/static/scripts/morpheus-bundle.js" defer fetchpriority="high"></script>
		</head>
		<body
			if sse.IsDevelopment() {
				data-init={ sse.HotReloadSSE() }
			}
		>
			@coreblocks.HeaderBody(user)
			{ children... }
			@coreblocks.FooterBody()
			@toasts.Container(props.Toasts)
		</body>
	</html>
}
