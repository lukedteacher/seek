package corelayouts

import (
	"seek/internal/features/users/models"
	"seek/internal/resources"
	"seek/internal/ui/core/coreblocks"
	"seek/internal/ui/core/coreblocks/toasts"
	"seek/pkg/sse"
	"seek/pkg/templui/components/toast"
)

templ LayoutBase(title string) {
	{{ user := models.GetUserFromContext(ctx) }}
	<!DOCTYPE html>
	<html lang="en" data-attr:data-theme="$theme">
		<head>
			<script>
				if (localStorage.getItem('theme') === null) {
					console.log("no value found")
					document.documentElement.setAttribute('data-theme', 'light');
					localStorage.setItem('theme', 'light')
				} else {
					console.log(localStorage.getItem('theme'))
					document.documentElement.setAttribute(
						'data-theme',
						localStorage.getItem('theme')
					);
				}
			</script>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script type="module" src={ resources.StaticPath("scripts/datastar.js") }></script>
			<link rel="stylesheet" href={ resources.StaticPath("styles/style.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/stellar.css") }/>
			<link rel="stylesheet" href={ resources.StaticPath("styles/global.css") }/>
			<script src="/static/scripts/morpheus-bundle.js" defer></script>
		</head>
		<body
			if sse.IsDevelopment() {
				data-init={ sse.HotReloadSSE() }
			}
		>
			@coreblocks.HeaderBody(user)
			<header class="h-16 w-full bg-transparent"></header>
			{ children... }
			@coreblocks.FooterBody()
			@toasts.ToastContainer("", "")
			@toast.Script()
		</body>
	</html>
}
